---
/**
 * Modal de conversión — Frictionless Clarity.
 * Dropzone + enlistado sin oferta. No toca el flujo de postulaciones por oferta.
 */
---

<dialog
  id="enlist-modal"
  class="enlist-dialog"
  aria-labelledby="enlist-title"
  aria-describedby="enlist-sub"
>
  <div class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4 mb-1">
      <h2 id="enlist-title" class="text-xl sm:text-2xl font-semibold tracking-tight text-foreground">
        Carga tu CV y listo
      </h2>
      <button
        type="button"
        id="enlist-close"
        class="btn-ghost !p-2 !min-h-11 !min-w-11 shrink-0"
        aria-label="Cerrar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <p id="enlist-sub" class="text-muted-foreground text-sm sm:text-base">
      Sin crear cuenta. En segundos quedas enlistado.
    </p>
    <p class="text-sm text-muted-foreground mt-1.5 mb-6">
      Luego el sistema te puede proponer ofertas que calzan con tu perfil.
    </p>

    <div id="enlist-form-wrap">
      <form id="form-enlist" class="space-y-4" novalidate>
        <div
          id="enlist-dropzone"
          class="border border-dashed border-border rounded-card p-6 min-h-[8.5rem] hover:border-accent/40 cursor-pointer bg-muted/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring"
          tabindex="0"
          role="button"
          aria-label="Subir CV PDF o Word, máximo 5MB"
        >
          <input
            type="file"
            name="cv"
            id="enlist-cv"
            accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            class="sr-only"
          />
          <div id="enlist-placeholder" class="text-center">
            <p class="text-sm font-semibold text-foreground">Toca o arrastra tu CV</p>
            <p class="text-xs text-muted-foreground mt-1">PDF o Word · máx. 5 MB</p>
          </div>
          <div id="enlist-preview" class="hidden text-center">
            <p id="enlist-cv-name" class="text-sm font-medium text-foreground truncate"></p>
            <p id="enlist-cv-size" class="text-xs text-muted-foreground mt-0.5"></p>
            <button type="button" id="enlist-cv-clear" class="mt-2 text-xs text-muted-foreground hover:text-destructive">
              Quitar
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="enlist-nombre" class="label-field text-muted-foreground font-normal">Nombre <span class="text-muted-foreground/70">(opcional)</span></label>
            <input id="enlist-nombre" type="text" name="nombre" autocomplete="name" placeholder="Tu nombre" class="input-field" />
          </div>
          <div>
            <label for="enlist-email" class="label-field text-muted-foreground font-normal">Email <span class="text-muted-foreground/70">(opcional)</span></label>
            <input id="enlist-email" type="email" name="email" autocomplete="email" placeholder="tu@email.com" class="input-field" />
          </div>
        </div>

        <label class="flex items-start gap-2.5 text-xs text-muted-foreground leading-relaxed">
          <input type="checkbox" id="enlist-privacidad" name="privacidad" required class="mt-0.5 h-4 w-4 rounded border-border" />
          Acepto que mi CV se use para proponerme ofertas y se elimine a los 90 días.
        </label>

        <div id="enlist-error" class="hidden alert-error" role="alert" aria-live="polite">
          <span></span>
        </div>

        <button type="submit" id="enlist-submit" class="btn-primary w-full py-3.5 min-h-12">
          <span id="enlist-submit-txt">Enlistarme ahora</span>
        </button>
      </form>
    </div>

    <div id="enlist-success" class="hidden py-4" role="status" aria-live="polite">
      <p class="text-lg font-semibold text-foreground">Listo. Ya estás enlistado.</p>
      <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
        Te podemos proponer ofertas que calzan con tu perfil.
      </p>
      <button type="button" id="enlist-see-jobs" class="btn-primary mt-6">
        Ver ofertas
      </button>
    </div>
  </div>
</dialog>

<style>
  .enlist-dialog {
    width: min(32rem, calc(100vw - 1.5rem));
    max-height: min(92vh, 44rem);
    margin: auto;
    overflow: auto;
    border: 1px solid oklch(var(--border));
    border-radius: var(--radius-card);
    padding: 0;
    background: oklch(var(--background));
    color: oklch(var(--foreground));
    box-shadow: none;
  }
  .enlist-dialog::backdrop {
    background: oklch(0.22 0.02 250 / 0.35);
  }
  .enlist-dialog[data-dragging='true'] #enlist-dropzone {
    border-color: oklch(var(--accent) / 0.55);
    background: oklch(var(--accent) / 0.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .enlist-dialog,
    .enlist-dialog::backdrop {
      transition: none;
    }
  }
</style>

<script>
  const MAX_CV = 5 * 1024 * 1024;
  const ALLOWED_EXT = ['.pdf', '.doc', '.docx'];

  function formatSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function validateClientFile(file: File): string | null {
    const name = file.name.toLowerCase();
    if (!ALLOWED_EXT.some((ext) => name.endsWith(ext))) {
      return 'Solo se aceptan archivos PDF o Word.';
    }
    if (file.size > MAX_CV) return 'El CV supera el tamaño máximo de 5MB.';
    if (file.size === 0) return 'Debes adjuntar tu CV.';
    return null;
  }

  document.addEventListener('astro:page-load', () => {
    const dialog = document.getElementById('enlist-modal') as HTMLDialogElement | null;
    const openBtn = document.getElementById('open-enlist');
    const closeBtn = document.getElementById('enlist-close');
    const form = document.getElementById('form-enlist') as HTMLFormElement | null;
    const dropzone = document.getElementById('enlist-dropzone');
    const cvInput = document.getElementById('enlist-cv') as HTMLInputElement | null;
    const placeholder = document.getElementById('enlist-placeholder');
    const preview = document.getElementById('enlist-preview');
    const cvName = document.getElementById('enlist-cv-name');
    const cvSize = document.getElementById('enlist-cv-size');
    const cvClear = document.getElementById('enlist-cv-clear');
    const errEl = document.getElementById('enlist-error');
    const submitBtn = document.getElementById('enlist-submit') as HTMLButtonElement | null;
    const submitTxt = document.getElementById('enlist-submit-txt');
    const formWrap = document.getElementById('enlist-form-wrap');
    const success = document.getElementById('enlist-success');
    const seeJobs = document.getElementById('enlist-see-jobs');

    if (!dialog || dialog.dataset.bound === '1') return;
    dialog.dataset.bound = '1';

    const showError = (msg: string) => {
      if (!errEl) return;
      const span = errEl.querySelector('span');
      if (span) span.textContent = msg;
      errEl.classList.remove('hidden');
    };
    const hideError = () => errEl?.classList.add('hidden');

    const setCvFile = (file: File | null) => {
      if (!cvInput) return;
      if (!file) {
        cvInput.value = '';
        placeholder?.classList.remove('hidden');
        preview?.classList.add('hidden');
        return;
      }
      const err = validateClientFile(file);
      if (err) {
        showError(err);
        setCvFile(null);
        return;
      }
      hideError();
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        cvInput.files = dt.files;
      } catch {
        /* change handler covers native pick */
      }
      if (cvName) cvName.textContent = file.name;
      if (cvSize) cvSize.textContent = formatSize(file.size);
      placeholder?.classList.add('hidden');
      preview?.classList.remove('hidden');
    };

    const open = () => {
      hideError();
      dialog.showModal();
      dropzone?.focus();
    };
    const close = () => {
      dialog.close();
      openBtn?.focus();
    };

    openBtn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    seeJobs?.addEventListener('click', () => {
      close();
      document.getElementById('listado-ofertas')?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    dropzone?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#enlist-cv-clear')) return;
      cvInput?.click();
    });
    dropzone?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        cvInput?.click();
      }
    });

    cvInput?.addEventListener('change', () => {
      const f = cvInput.files?.[0] || null;
      if (f) setCvFile(f);
    });
    cvClear?.addEventListener('click', (e) => {
      e.stopPropagation();
      setCvFile(null);
    });

    ['dragenter', 'dragover'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dialog.setAttribute('data-dragging', 'true');
      });
    });
    ['dragleave', 'drop'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dialog.removeAttribute('data-dragging');
      });
    });
    dropzone?.addEventListener('drop', (e) => {
      const de = e as DragEvent;
      const f = de.dataTransfer?.files?.[0];
      if (f) setCvFile(f);
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();
      if (!submitBtn || !submitTxt) return;
      if (!cvInput?.files?.[0]) {
        showError('Debes adjuntar tu CV.');
        return;
      }
      const privacy = document.getElementById('enlist-privacidad') as HTMLInputElement | null;
      if (privacy && !privacy.checked) {
        showError('Debes aceptar el tratamiento de tu CV.');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      submitTxt.innerHTML = '<span class="spinner" aria-hidden="true"></span> Enlistando…';

      try {
        const body = new FormData(form);
        const res = await fetch('/api/enlist', { method: 'POST', body });
        const data = await res.json();
        if (res.ok && data.ok) {
          formWrap?.classList.add('hidden');
          success?.classList.remove('hidden');
          closeBtn?.focus();
        } else {
          showError(data.error || 'No pudimos guardar tu CV. Intenta de nuevo.');
          submitTxt.textContent = 'Enlistarme ahora';
          submitBtn.disabled = false;
          submitBtn.removeAttribute('aria-busy');
        }
      } catch {
        showError('Sin conexión. Revisa tu internet e intenta otra vez.');
        submitTxt.textContent = 'Enlistarme ahora';
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
      }
    });
  });
</script>
