---
/**
 * Modal de conversión. El CTA del hero lo abre.
 * Copy: una vez el CV, sin formularios, te recomendamos ofertas.
 */
---

<dialog
  id="enlist-modal"
  class="enlist-dialog"
  aria-labelledby="enlist-title"
  aria-describedby="enlist-sub"
>
  <div class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <h2 id="enlist-title" class="text-xl sm:text-2xl font-semibold tracking-tight text-foreground">
        Sube tu CV una sola vez
      </h2>
      <button type="button" id="enlist-close" class="btn-ghost !p-2 !min-h-11 !min-w-11" aria-label="Cerrar">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <p id="enlist-sub" class="text-muted-foreground mt-2 text-sm sm:text-base">
      Sin cuenta. Sin campos interminables. En segundos quedas enlistado.
    </p>
    <p class="text-sm text-foreground mt-2 mb-6">
      Nosotros te recomendamos los trabajos que calzan contigo.
    </p>

    <div id="enlist-form-wrap">
      <form id="form-enlist" class="space-y-4" novalidate>
        <div
          id="enlist-dropzone"
          class="border border-dashed border-border rounded-card p-6 sm:p-8 text-center bg-muted/40"
        >
          <input
            type="file"
            name="cv"
            id="enlist-cv"
            accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            class="sr-only"
          />
          <div id="enlist-placeholder">
            <p class="text-sm font-semibold text-foreground">PDF o Word · máx. 5 MB</p>
            <label for="enlist-cv" class="btn-primary inline-flex mt-4 px-5 py-3 min-h-12 cursor-pointer">
              Subir PDF o Word
            </label>
            <p class="text-xs text-muted-foreground mt-3">O arrastra el archivo aquí</p>
          </div>
          <div id="enlist-preview" class="hidden">
            <p id="enlist-cv-name" class="text-sm font-medium text-foreground truncate"></p>
            <p id="enlist-cv-size" class="text-xs text-muted-foreground mt-0.5"></p>
            <button type="button" id="enlist-cv-clear" class="mt-3 text-sm text-muted-foreground hover:text-destructive">
              Quitar archivo
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="enlist-nombre" class="label-field font-normal text-muted-foreground">Nombre (opcional)</label>
            <input id="enlist-nombre" type="text" name="nombre" autocomplete="name" placeholder="Tu nombre" class="input-field" />
          </div>
          <div>
            <label for="enlist-email" class="label-field font-normal text-muted-foreground">Email (opcional)</label>
            <input id="enlist-email" type="email" name="email" autocomplete="email" placeholder="tu@email.com" class="input-field" />
          </div>
        </div>

        <label class="flex items-start gap-2.5 text-xs text-muted-foreground leading-relaxed">
          <input type="checkbox" id="enlist-privacidad" name="privacidad" required class="mt-0.5 h-4 w-4 rounded border-border" />
          Acepto que mi CV se use para recomendarme ofertas y se elimine a los 90 días.
        </label>

        <div id="enlist-error" class="hidden alert-error" hidden role="alert" aria-live="polite"><span></span></div>

        <button type="submit" id="enlist-submit" class="btn-primary w-full py-3.5 min-h-12">
          <span id="enlist-submit-txt">Enlistarme ahora</span>
        </button>
      </form>
    </div>

    <div id="enlist-success" class="hidden py-4" role="status" aria-live="polite">
      <p class="text-lg font-semibold text-foreground">Listo. Ya estás enlistado.</p>
      <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
        Te recomendaremos ofertas que calcen con tu perfil.
      </p>
      <button type="button" id="enlist-see-jobs" class="btn-primary mt-6">Ver ofertas</button>
    </div>
  </div>
</dialog>

<style>
  .enlist-dialog {
    width: min(32rem, calc(100vw - 1.5rem));
    max-height: min(92vh, 44rem);
    margin: auto;
    overflow: auto;
    border: 1px solid oklch(var(--border));
    border-radius: var(--radius-card);
    padding: 0;
    background: oklch(var(--background));
    color: oklch(var(--foreground));
  }
  .enlist-dialog::backdrop {
    background: oklch(0.22 0.02 250 / 0.4);
  }
  .enlist-dialog[data-dragging='true'] #enlist-dropzone {
    border-color: oklch(var(--accent) / 0.55);
    background: oklch(var(--accent) / 0.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .enlist-dialog,
    .enlist-dialog::backdrop { transition: none; }
  }
</style>

<script>
  const MAX_CV = 5 * 1024 * 1024;
  const ALLOWED_EXT = ['.pdf', '.doc', '.docx'];

  function formatSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function validateClientFile(file: File): string | null {
    const name = file.name.toLowerCase();
    if (!ALLOWED_EXT.some((ext) => name.endsWith(ext))) return 'Solo se aceptan archivos PDF o Word.';
    if (file.size > MAX_CV) return 'El CV supera el tamaño máximo de 5MB.';
    if (file.size === 0) return 'Debes adjuntar tu CV.';
    return null;
  }

  function bindEnlist() {
    const dialog = document.getElementById('enlist-modal') as HTMLDialogElement | null;
    const form = document.getElementById('form-enlist') as HTMLFormElement | null;
    if (!dialog || !form || dialog.dataset.bound === '1') return;
    dialog.dataset.bound = '1';

    const dropzone = document.getElementById('enlist-dropzone');
    const cvInput = document.getElementById('enlist-cv') as HTMLInputElement | null;
    const placeholder = document.getElementById('enlist-placeholder');
    const preview = document.getElementById('enlist-preview');
    const cvName = document.getElementById('enlist-cv-name');
    const cvSize = document.getElementById('enlist-cv-size');
    const errEl = document.getElementById('enlist-error');
    const submitBtn = document.getElementById('enlist-submit') as HTMLButtonElement | null;
    const submitTxt = document.getElementById('enlist-submit-txt');
    const formWrap = document.getElementById('enlist-form-wrap');
    const success = document.getElementById('enlist-success');

    const showError = (msg: string) => {
      const span = errEl?.querySelector('span');
      if (span) span.textContent = msg;
      errEl?.classList.remove('hidden');
      errEl?.removeAttribute('hidden');
    };
    const hideError = () => {
      errEl?.classList.add('hidden');
      errEl?.setAttribute('hidden', '');
    };

    const open = () => {
      hideError();
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
    };
    const close = () => {
      dialog.close();
      document.getElementById('open-enlist')?.focus();
    };

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('#open-enlist')) {
        e.preventDefault();
        open();
      }
    });

    document.getElementById('enlist-close')?.addEventListener('click', close);
    document.getElementById('enlist-see-jobs')?.addEventListener('click', () => {
      close();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.getElementById('listado-ofertas')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    const setCvFile = (file: File | null) => {
      if (!cvInput) return;
      if (!file) {
        cvInput.value = '';
        placeholder?.classList.remove('hidden');
        preview?.classList.add('hidden');
        return;
      }
      const err = validateClientFile(file);
      if (err) {
        showError(err);
        setCvFile(null);
        return;
      }
      hideError();
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        cvInput.files = dt.files;
      } catch { /* native */ }
      if (cvName) cvName.textContent = file.name;
      if (cvSize) cvSize.textContent = formatSize(file.size);
      placeholder?.classList.add('hidden');
      preview?.classList.remove('hidden');
    };

    dropzone?.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('label') || t.closest('#enlist-cv-clear') || t.closest('input')) return;
      cvInput?.click();
    });
    cvInput?.addEventListener('change', () => {
      const f = cvInput.files?.[0];
      if (f) setCvFile(f);
    });
    document.getElementById('enlist-cv-clear')?.addEventListener('click', (e) => {
      e.stopPropagation();
      setCvFile(null);
    });

    ['dragenter', 'dragover'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        dialog.setAttribute('data-dragging', 'true');
      });
    });
    ['dragleave', 'drop'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        dialog.removeAttribute('data-dragging');
      });
    });
    dropzone?.addEventListener('drop', (e) => {
      const f = (e as DragEvent).dataTransfer?.files?.[0];
      if (f) setCvFile(f);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();
      if (!submitBtn || !submitTxt) return;
      if (!cvInput?.files?.[0]) {
        showError('Debes adjuntar tu CV.');
        return;
      }
      const privacy = document.getElementById('enlist-privacidad') as HTMLInputElement | null;
      if (privacy && !privacy.checked) {
        showError('Debes aceptar el tratamiento de tu CV.');
        return;
      }
      submitBtn.disabled = true;
      submitTxt.innerHTML = '<span class="spinner" aria-hidden="true"></span> Enlistando…';
      try {
        const res = await fetch('/api/enlist', { method: 'POST', body: new FormData(form) });
        let data: { ok?: boolean; error?: string } = {};
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
          try { data = await res.json(); } catch { data = {}; }
        }
        if (res.ok && data.ok) {
          formWrap?.classList.add('hidden');
          success?.classList.remove('hidden');
        } else {
          showError(data.error || 'No pudimos guardar tu CV. Intenta de nuevo.');
          submitTxt.textContent = 'Enlistarme ahora';
          submitBtn.disabled = false;
        }
      } catch {
        showError('Sin conexión. Revisa tu internet e intenta otra vez.');
        submitTxt.textContent = 'Enlistarme ahora';
        submitBtn.disabled = false;
      }
    });
  }

  document.addEventListener('astro:page-load', bindEnlist);
  if (document.readyState !== 'loading') bindEnlist();
</script>
