---
import type { PageInfo } from '../../lib/pagination';
import { pageHref } from '../../lib/pagination';

interface Props {
  pageInfo: PageInfo;
  pathname: string;
  searchParams: URLSearchParams;
  /** Etiqueta accesible del listado */
  label?: string;
}

const { pageInfo, pathname, searchParams, label = 'Paginación' } = Astro.props;
const { page, totalPages, total, hasPrev, hasNext, pageSize } = pageInfo;

if (totalPages <= 1 || total === 0) {
  return null;
}

const prevHref = pageHref(pathname, searchParams, page - 1);
const nextHref = pageHref(pathname, searchParams, page + 1);

// Ventana de páginas compacta (máx. 5 números)
const windowSize = 5;
let start = Math.max(1, page - Math.floor(windowSize / 2));
let end = Math.min(totalPages, start + windowSize - 1);
start = Math.max(1, end - windowSize + 1);
const pages: number[] = [];
for (let p = start; p <= end; p++) pages.push(p);

const fromItem = (page - 1) * pageSize + 1;
const toItem = Math.min(page * pageSize, total);
---

<nav class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-3" aria-label={label}>
  <p class="text-xs text-muted-foreground font-medium tabular-nums order-2 sm:order-1">
    {fromItem}–{toItem} de {total}
  </p>
  <div class="flex items-center gap-1.5 order-1 sm:order-2">
    {hasPrev ? (
      <a
        href={prevHref}
        class="inline-flex items-center gap-1 min-h-10 px-3 text-sm font-medium text-foreground border border-border rounded-control bg-card hover:border-accent/40 transition-colors duration-micro"
        rel="prev"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 19l-7-7 7-7" />
        </svg>
        Anterior
      </a>
    ) : (
      <span
        class="inline-flex items-center gap-1 min-h-10 px-3 text-sm font-medium text-muted-foreground/40 border border-border/50 rounded-control cursor-not-allowed"
        aria-disabled="true"
      >
        Anterior
      </span>
    )}

    <div class="hidden sm:flex items-center gap-1">
      {pages.map((p) =>
        p === page ? (
          <span
            class="min-w-10 min-h-10 inline-flex items-center justify-center text-sm font-semibold rounded-control bg-primary text-primary-foreground"
            aria-current="page"
          >
            {p}
          </span>
        ) : (
          <a
            href={pageHref(pathname, searchParams, p)}
            class="min-w-10 min-h-10 inline-flex items-center justify-center text-sm font-medium rounded-control text-muted-foreground border border-border bg-card hover:text-foreground hover:border-accent/40 transition-colors duration-micro"
          >
            {p}
          </a>
        ),
      )}
    </div>

    <span class="sm:hidden text-xs font-medium text-muted-foreground tabular-nums px-2">
      {page} / {totalPages}
    </span>

    {hasNext ? (
      <a
        href={nextHref}
        class="inline-flex items-center gap-1 min-h-10 px-3 text-sm font-medium text-foreground border border-border rounded-control bg-card hover:border-accent/40 transition-colors duration-micro"
        rel="next"
      >
        Siguiente
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    ) : (
      <span
        class="inline-flex items-center gap-1 min-h-10 px-3 text-sm font-medium text-muted-foreground/40 border border-border/50 rounded-control cursor-not-allowed"
        aria-disabled="true"
      >
        Siguiente
      </span>
    )}
  </div>
</nav>
