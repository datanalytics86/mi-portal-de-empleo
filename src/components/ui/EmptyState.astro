---
interface Props {
  title: string;
  description: string;
  /** Optional secondary link text */
  secondaryHref?: string;
  secondaryLabel?: string;
  class?: string;
}

const {
  title,
  description,
  secondaryHref,
  secondaryLabel,
  class: className = '',
} = Astro.props;
---

<div class:list={['card relative overflow-hidden rounded-3xl p-12 sm:p-16 text-center', className]}>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-brand-50/40 to-transparent" aria-hidden="true"></div>
  <div class="relative">
    <div class="mx-auto mb-6 w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-gradient-to-br from-brand-50 to-indigo-50 border border-brand-100 flex items-center justify-center shadow-soft">
      <slot name="icon">
        <svg class="w-12 h-12 text-brand-400" fill="none" viewBox="0 0 64 64" aria-hidden="true">
          <rect x="12" y="14" width="40" height="36" rx="6" stroke="currentColor" stroke-width="2" class="text-brand-300"/>
          <path d="M22 28h20M22 36h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <circle cx="44" cy="42" r="10" fill="#eef2ff" stroke="#818cf8" stroke-width="2"/>
          <path d="M44 37v10M39 42h10" stroke="#4f46e5" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </slot>
    </div>
    <p class="text-slate-900 font-extrabold text-xl tracking-tight mb-2">{title}</p>
    <p class="text-sm text-slate-500 max-w-md mx-auto leading-relaxed mb-8">{description}</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <slot name="actions" />
      {secondaryHref && secondaryLabel && (
        <a href={secondaryHref} class="text-sm font-medium text-slate-500 hover:text-brand-700 transition-colors">
          {secondaryLabel}
        </a>
      )}
    </div>
    <slot name="footer" />
  </div>
</div>
