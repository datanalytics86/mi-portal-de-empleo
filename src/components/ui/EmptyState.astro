---
interface Props {
  title: string;
  description: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  class?: string;
}

const {
  title,
  description,
  secondaryHref,
  secondaryLabel,
  class: className = '',
} = Astro.props;
---

<div class:list={['py-16 sm:py-20 text-center', className]}>
  <span class="brand-mark mx-auto mb-6 block" aria-hidden="true"></span>
  <p class="text-foreground font-semibold tracking-tight text-lg mb-2">{title}</p>
  <p class="text-sm text-muted-foreground max-w-md mx-auto leading-relaxed mb-8">{description}</p>
  <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
    <slot name="actions" />
    {secondaryHref && secondaryLabel && (
      <a href={secondaryHref} class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors duration-micro">
        {secondaryLabel}
      </a>
    )}
  </div>
  <slot name="footer" />
</div>
