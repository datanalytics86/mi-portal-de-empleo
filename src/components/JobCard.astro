---
import { TIPOS } from '../lib/constants';

interface Props {
  id: string;
  titulo: string;
  empresa: string;
  tipo_empleo: string;
  categoria?: string | null;
  comuna: string;
  created_at: string;
  expira_en: string;
  is_demo?: boolean;
  index?: number;
}

const {
  id,
  titulo,
  empresa,
  tipo_empleo,
  categoria,
  comuna,
  created_at,
  expira_en,
  is_demo = false,
} = Astro.props;

const esNueva = !is_demo && Date.now() - new Date(created_at).getTime() < 48 * 3600 * 1000;
const diasRestantes = Math.ceil(
  (new Date(expira_en).getTime() - Date.now()) / (1000 * 60 * 60 * 24),
);
const fecha = new Date(created_at).toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'short',
});
const urgenciaLabel = diasRestantes <= 1 ? 'Último día' : ('Cierra en ' + diasRestantes + 'd');
---

<a href={`/oferta/${id}`} class="job-card group">
  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <h2 class="truncate text-[0.95rem] font-semibold tracking-tight text-foreground sm:text-base">
            {titulo}
          </h2>
          {is_demo && (
            <span class="shrink-0 text-[11px] font-medium text-muted-foreground">Demo</span>
          )}
          {esNueva && (
            <span class="shrink-0 text-[11px] font-medium text-accent">Nueva</span>
          )}
          {diasRestantes <= 5 && (
            <span class:list={[
              'shrink-0 text-[11px] font-medium',
              diasRestantes <= 1 ? 'text-destructive' : 'text-muted-foreground',
            ]}>
              {urgenciaLabel}
            </span>
          )}
        </div>
        <p class="mt-0.5 text-sm text-muted-foreground">{empresa}</p>
      </div>
      <time class="mt-0.5 shrink-0 text-[12px] tabular-nums text-muted-foreground" datetime={created_at}>
        {fecha}
      </time>
    </div>
    <p class="mt-1.5 text-[13px] text-muted-foreground">
      {comuna}
      <span class="mx-1.5 text-muted-foreground/40" aria-hidden="true">·</span>
      {TIPOS[tipo_empleo] || tipo_empleo}
      {categoria && (
        <>
          <span class="mx-1.5 text-muted-foreground/40" aria-hidden="true">·</span>
          {categoria}
        </>
      )}
    </p>
  </div>
</a>
