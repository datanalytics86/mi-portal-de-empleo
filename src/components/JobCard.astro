---
/**
  * Job card — Quiet Opportunity.
  * Hover communicates state (border + 1px shift), never lift-and-glow.
  * “Nueva” is a 2px teal hairline, not a rainbow chip.
  */
import { TIPOS } from '../lib/constants';

interface Props {
  id: string;
  titulo: string;
  empresa: string;
  tipo_empleo: string;
  categoria?: string | null;
  comuna: string;
  created_at: string;
  expira_en: string;
  index?: number;
}

const {
  id,
  titulo,
  empresa,
  tipo_empleo,
  categoria,
  comuna,
  created_at,
  expira_en,
  index = 0,
} = Astro.props;

const esNueva = Date.now() - new Date(created_at).getTime() < 48 * 3600 * 1000;
const diasRestantes = Math.ceil(
  (new Date(expira_en).getTime() - Date.now()) / (1000 * 60 * 60 * 24),
);
const iniciales = empresa
  .split(' ')
  .slice(0, 2)
  .map((w) => w[0] || '')
  .join('')
  .toUpperCase()
  .slice(0, 2);
const fecha = new Date(created_at).toLocaleDateString('es-CL', {
  day: 'numeric',
  month: 'short',
});
const delay = index * 40 + 'ms';
const enterStyle = '--enter-delay: ' + delay + '; view-transition-name: vt-job-' + id;
const urgenciaLabel = diasRestantes <= 1 ? 'Último día' : ('Cierra en ' + diasRestantes + 'd');
---

<a
  href={`/oferta/${id}`}
  class:list={['job-card group', esNueva && 'job-card--nueva']}
  style={enterStyle}
>
  <div class="job-card__mono" aria-hidden="true">{iniciales}</div>

  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
          <h2 class="truncate text-[0.95rem] font-semibold tracking-tight text-foreground sm:text-base">
            {titulo}
          </h2>
          {esNueva && (
            <span class="shrink-0 text-[10px] font-medium uppercase tracking-[0.14em] text-accent">
              Nueva
            </span>
          )}
          {diasRestantes <= 5 && (
            <span class:list={[
              'shrink-0 text-[10px] font-medium uppercase tracking-[0.08em]',
              diasRestantes <= 1 ? 'text-destructive' : 'text-muted-foreground',
            ]}>
              {urgenciaLabel}
            </span>
          )}
        </div>
        <p class="mt-0.5 text-sm font-medium text-muted-foreground">{empresa}</p>
      </div>
      <time
        class="mt-0.5 shrink-0 font-medium tabular-nums text-[11px] text-muted-foreground/70"
        datetime={created_at}
      >
        {fecha}
      </time>
    </div>

    <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[12px] text-muted-foreground">
      <span>{comuna}</span>
      <span class="text-muted-foreground/35" aria-hidden="true">·</span>
      <span>{TIPOS[tipo_empleo] || tipo_empleo}</span>
      {categoria && (
        <>
          <span class="text-muted-foreground/35" aria-hidden="true">·</span>
          <span>{categoria}</span>
        </>
      )}
    </p>
  </div>

  <span
    class="hidden self-center text-muted-foreground/40 transition-transform duration-move ease-quiet group-hover:translate-x-0.5 group-hover:text-accent sm:block"
    aria-hidden="true"
  >
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
