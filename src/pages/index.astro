---
import Layout from '../layouts/Layout.astro';
import Pagination from '../components/ui/Pagination.astro';
import JobCard from '../components/JobCard.astro';
import CvEnlistModal from '../components/CvEnlistModal.astro';
import { supabase } from '../lib/supabase';
import { TIPOS, CATEGORIAS, BRAND_HEX, MAP_TILE_LIGHT } from '../lib/constants';
import {
  DEFAULT_PAGE_SIZE,
  MAP_MARKERS_CAP,
  buildPageInfo,
  parsePage,
} from '../lib/pagination';

const { searchParams, pathname } = Astro.url;
const q = searchParams.get('q') || '';
const tipo = searchParams.get('tipo') || '';
const comuna = searchParams.get('comuna') || '';
const categoria = searchParams.get('categoria') || '';
const page = parsePage(searchParams.get('page'));

let listQuery = supabase
  .from('ofertas')
  .select(
    'id, titulo, empresa, tipo_empleo, categoria, comuna, created_at, expira_en, lat, lng',
    { count: 'exact' },
  )
  .eq('activa', true)
  .gte('expira_en', new Date().toISOString())
  .order('created_at', { ascending: false });

if (q) listQuery = listQuery.ilike('titulo', `%${q}%`);
if (tipo) listQuery = listQuery.eq('tipo_empleo', tipo);
if (comuna) listQuery = listQuery.ilike('comuna', `%${comuna}%`);
if (categoria) listQuery = listQuery.eq('categoria', categoria);

const provisionalFrom = (page - 1) * DEFAULT_PAGE_SIZE;
const { data: ofertasRaw, count: totalCount } = await listQuery.range(
  provisionalFrom,
  provisionalFrom + DEFAULT_PAGE_SIZE - 1,
);

const total = totalCount ?? ofertasRaw?.length ?? 0;
const pageInfo = buildPageInfo(page, DEFAULT_PAGE_SIZE, total);
const ofertas = ofertasRaw ?? [];

let mapQuery = supabase
  .from('ofertas')
  .select('id, titulo, empresa, lat, lng, comuna, categoria')
  .eq('activa', true)
  .gte('expira_en', new Date().toISOString())
  .order('created_at', { ascending: false })
  .limit(MAP_MARKERS_CAP);
if (q) mapQuery = mapQuery.ilike('titulo', `%${q}%`);
if (tipo) mapQuery = mapQuery.eq('tipo_empleo', tipo);
if (comuna) mapQuery = mapQuery.ilike('comuna', `%${comuna}%`);
if (categoria) mapQuery = mapQuery.eq('categoria', categoria);
const { data: mapRows } = await mapQuery;

const mapaOfertas = (mapRows || []).map((o) => ({
  id: o.id,
  titulo: o.titulo,
  empresa: o.empresa,
  lat: o.lat,
  lng: o.lng,
  comuna: o.comuna,
  categoria: o.categoria ?? '',
}));

const hayFiltros = q || tipo || comuna || categoria;
const conCoords = mapaOfertas.filter((o) => o.lat && o.lng).length;

function buildCatUrl(cat: string | null) {
  const p = new URLSearchParams();
  if (cat) p.set('categoria', cat);
  if (q) p.set('q', q);
  if (tipo) p.set('tipo', tipo);
  if (comuna) p.set('comuna', comuna);
  const qs = p.toString();
  return qs ? `/?${qs}` : '/';
}
---

<Layout title="Empleos en Chile" leaflet={true}>
  <section class="px-4 pt-16 sm:pt-24 pb-8">
    <div class="max-w-measure mx-auto">
      <h1 class="text-display text-foreground max-w-[18ch]">
        ¿Aburrido de llenar formularios?
      </h1>
      <p class="mt-5 max-w-lg text-foreground text-lg sm:text-xl font-medium leading-snug">
        Sube tu CV una sola vez. Sin cuenta. Sin campos interminables.
      </p>
      <p class="mt-3 max-w-lg text-muted-foreground text-base leading-relaxed">
        Nosotros te recomendamos los trabajos que calzan contigo.
      </p>

      <div class="mt-8">
        <button
          type="button"
          id="open-enlist"
          class="btn-primary px-6 py-3.5 min-h-12 text-base"
          aria-haspopup="dialog"
          aria-controls="enlist-modal"
        >
          Postula con tu CV · Sin registro
        </button>
      </div>

      <CvEnlistModal />

      <form
        method="get"
        role="search"
        aria-label="Buscar ofertas"
        class="mt-10 flex flex-col sm:flex-row gap-2 max-w-xl"
      >
        <p class="sr-only">O busca una oferta</p>
        <input type="hidden" name="categoria" value={categoria} />
        <input type="hidden" name="tipo" value={tipo} />
        <input type="hidden" name="comuna" value={comuna} />
        <label for="search-q" class="sr-only">Cargo o empresa</label>
        <input
          id="search-q"
          type="text"
          name="q"
          value={q}
          placeholder="O busca una oferta"
          class="input-field flex-1"
        />
        <button type="submit" class="btn-secondary shrink-0 px-5">
          Buscar
        </button>
      </form>
    </div>
  </section>

  <div class="max-w-measure mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-10">
      <div id="listado-ofertas" class="lg:col-span-3">
        <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
          <p class="text-sm text-muted-foreground">
            <span class="text-foreground font-semibold tabular-nums">{total}</span>
            {' '}oferta{total !== 1 ? 's' : ''}
            {hayFiltros && <span class="ml-1.5">· filtrado</span>}
          </p>
          {hayFiltros && (
            <a href="/" class="text-sm text-muted-foreground hover:text-foreground">Limpiar filtros</a>
          )}
        </div>

        <div class="flex flex-wrap gap-x-3 gap-y-1.5 mb-6" role="navigation" aria-label="Categorías">
          <a
            href={buildCatUrl(null)}
            class:list={[
              'text-sm pb-0.5 border-b',
              !categoria ? 'text-foreground border-foreground' : 'text-muted-foreground border-transparent hover:text-foreground',
            ]}
            aria-current={!categoria ? 'page' : undefined}
          >
            Todas
          </a>
          {CATEGORIAS.map((cat) => (
            <a
              href={buildCatUrl(cat)}
              class:list={[
                'text-sm pb-0.5 border-b',
                categoria === cat ? 'text-foreground border-foreground' : 'text-muted-foreground border-transparent hover:text-foreground',
              ]}
              aria-current={categoria === cat ? 'page' : undefined}
            >
              {cat}
            </a>
          ))}
        </div>

        <form method="get" class="flex flex-wrap gap-2 mb-6">
          {q && <input type="hidden" name="q" value={q} />}
          {categoria && <input type="hidden" name="categoria" value={categoria} />}
          <label for="filter-tipo" class="sr-only">Tipo de empleo</label>
          <select id="filter-tipo" name="tipo" class="input-field !w-auto !py-2 text-sm">
            <option value="">Tipo</option>
            {Object.entries(TIPOS).map(([val, label]) => (
              <option value={val} selected={tipo === val}>{label}</option>
            ))}
          </select>
          <label for="filter-comuna" class="sr-only">Comuna</label>
          <input
            id="filter-comuna"
            type="text"
            name="comuna"
            value={comuna}
            placeholder="Comuna"
            class="input-field !w-40 !py-2 text-sm"
          />
          <button type="submit" class="btn-secondary !py-2">Filtrar</button>
        </form>

        {!ofertas || ofertas.length === 0 ? (
          <div class="py-14">
            <p class="text-foreground font-semibold">
              {hayFiltros ? 'Sin resultados' : 'Aún no hay ofertas'}
            </p>
            <p class="text-sm text-muted-foreground mt-2 max-w-sm">
              {hayFiltros
                ? 'Prueba otra búsqueda o limpia los filtros.'
                : 'Cuando una empresa publique, postulas solo con tu CV.'}
            </p>
            {hayFiltros ? (
              <a href="/" class="btn-primary mt-6">Ver todas</a>
            ) : (
              <a href="/empleador/login" class="btn-secondary mt-6">Publicar empleo</a>
            )}
          </div>
        ) : (
          <div class="space-y-2">
            {ofertas.map((oferta) => (
              <JobCard
                id={oferta.id}
                titulo={oferta.titulo}
                empresa={oferta.empresa}
                tipo_empleo={oferta.tipo_empleo}
                categoria={oferta.categoria}
                comuna={oferta.comuna}
                created_at={oferta.created_at}
                expira_en={oferta.expira_en}
              />
            ))}
          </div>
        )}
        {ofertas && ofertas.length > 0 && (
          <Pagination
            pageInfo={pageInfo}
            pathname={pathname}
            searchParams={searchParams}
            label="Paginación de ofertas"
          />
        )}
      </div>

      <div class="lg:col-span-2 lg:sticky lg:top-24 h-[240px] sm:h-[320px] lg:h-[400px] map-material relative">
        <div id="mapa" class="w-full h-full" role="application" aria-label="Mapa de ofertas de empleo"></div>
        {total === 0 || conCoords === 0 ? (
          <div class="absolute inset-0 flex items-center justify-center bg-background/85 pointer-events-none z-[400]">
            <p class="text-sm text-muted-foreground px-6 text-center">
              {total === 0 ? 'Sin ofertas en el mapa' : 'Sin ubicación en el mapa'}
            </p>
          </div>
        ) : null}
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ mapaOfertas, BRAND_HEX, MAP_TILE_LIGHT }}>
  document.addEventListener('astro:page-load', () => {
    const mapEl = document.getElementById('mapa');
    if (!mapEl || mapEl.dataset.mapReady === '1') return;
    if (typeof L === 'undefined') return;
    mapEl.dataset.mapReady = '1';

    const map = L.map('mapa', { zoomControl: false }).setView([-33.4569, -70.6483], 11);
    L.control.zoom({ position: 'topright' }).addTo(map);

    L.tileLayer(MAP_TILE_LIGHT, {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
      maxZoom: 18,
    }).addTo(map);

    function esc(s) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    mapaOfertas.forEach((oferta) => {
      if (!oferta.lat || !oferta.lng) return;
      const icon = L.divIcon({
        html: '<div style="width:10px;height:10px;background:' + BRAND_HEX + ';border-radius:2px;border:2px solid white"></div>',
        className: '',
        iconSize: [10, 10],
        iconAnchor: [5, 5],
      });
      const marker = L.marker([oferta.lat, oferta.lng], { icon });
      marker.bindPopup(
        '<div style="min-width:160px"><strong>' + esc(oferta.titulo) + '</strong><br>' +
        '<span style="opacity:.7">' + esc(oferta.empresa) + '</span><br>' +
        '<span style="opacity:.5;font-size:12px">' + esc(oferta.comuna) + '</span><br>' +
        '<a href="/oferta/' + encodeURIComponent(oferta.id) + '" style="color:' + BRAND_HEX + ';font-size:13px;font-weight:600">Ver oferta</a></div>'
      );
      marker.addTo(map);
    });

    setTimeout(() => map.invalidateSize(), 100);
  });
</script>
