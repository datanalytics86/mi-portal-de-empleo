---
import Layout from '../../layouts/Layout.astro';
import { createServiceClient } from '../../lib/supabase';
import { TIPOS, BRAND_HEX, MAP_TILE_DARK, MAP_TILE_LIGHT } from '../../lib/constants';

const { id } = Astro.params;

// Usa service role para leer sin restricciones RLS y poder distinguir
// "no existe" de "expirada" (la policy pública filtra activa+expira_en)
const { data: ofertaRaw, error } = id
  ? await createServiceClient().from('ofertas').select('*').eq('id', id).single()
  : { data: null, error: true };

const isExpired = ofertaRaw && (!ofertaRaw.activa || ofertaRaw.expira_en < new Date().toISOString());
const notFound = !ofertaRaw || !!error;

if (notFound) Astro.response.status = 404;
if (isExpired) Astro.response.status = 410;

// Solo continúa al renderizado normal si la oferta es válida
const oferta = !notFound && !isExpired ? ofertaRaw : null;

const exito = Astro.url.searchParams.get('exito') === '1';

// JSON-LD JobPosting para Google Jobs
const SCHEMA_TIPOS: Record<string, string> = {
  'full-time': 'FULL_TIME',
  'part-time': 'PART_TIME',
  'freelance': 'CONTRACTOR',
  'practica': 'INTERN',
};

const jsonLd = oferta ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: oferta.titulo,
  description: oferta.descripcion,
  datePosted: oferta.created_at.split('T')[0],
  validThrough: oferta.expira_en.split('T')[0],
  employmentType: SCHEMA_TIPOS[oferta.tipo_empleo] || 'OTHER',
  hiringOrganization: { '@type': 'Organization', name: oferta.empresa },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: oferta.comuna,
      addressCountry: 'CL',
    },
  },
  ...(oferta.categoria ? { occupationalCategory: oferta.categoria } : {}),
}) : null;

const ofertaDescription = oferta
  ? `${oferta.empresa} busca ${oferta.titulo} en ${oferta.comuna}, Chile. ${oferta.descripcion.slice(0, 140).replace(/\n/g, ' ').trim()}${oferta.descripcion.length > 140 ? '…' : ''} · Postula gratis sin registro.`
  : 'Oferta laboral en Chile. Postula con tu CV en segundos.';

const ofertaOgTitle = oferta
  ? `${oferta.titulo} — ${oferta.empresa} · ${oferta.comuna}`
  : 'Oferta no disponible';

// Barra de progreso del tiempo
const diasRestantes = oferta
  ? Math.max(0, Math.ceil((new Date(oferta.expira_en).getTime() - Date.now()) / (1000 * 60 * 60 * 24)))
  : 0;
const totalDias = oferta
  ? Math.max(1, Math.ceil((new Date(oferta.expira_en).getTime() - new Date(oferta.created_at).getTime()) / (1000 * 60 * 60 * 24)))
  : 1;
const pctTranscurrido = Math.min(100, Math.round(((totalDias - diasRestantes) / totalDias) * 100));
// Pre-computadas para evitar template literals anidados en expresiones Astro
const urgenciaTexto = diasRestantes <= 1 ? 'Último día' : diasRestantes <= 5 ? ('Cierra en ' + diasRestantes + ' días') : (diasRestantes + ' días restantes');
const barraColor = 'h-full rounded-full transition-all ' + (diasRestantes <= 3 ? 'bg-destructive' : diasRestantes <= 7 ? 'bg-warning' : 'bg-accent');
const barraWidth = 'width: ' + pctTranscurrido + '%';
// Tiempo estimado de lectura (~200 palabras/min)
const readingTime = oferta
  ? Math.max(1, Math.round(oferta.descripcion.split(/\s+/).filter(Boolean).length / 200))
  : 0;
---

{(notFound || isExpired) && (
  <Layout title="Oferta no disponible">
    <div class="max-w-lg mx-auto px-4 py-24 text-center">
      <div class="card p-8 sm:p-10">
        <div class="w-12 h-12 border border-border bg-muted rounded-input flex items-center justify-center mx-auto mb-6">
          {isExpired ? (
            <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          ) : (
            <svg class="w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          )}
        </div>
        {isExpired ? (
          <>
            <h1 class="text-2xl font-semibold text-foreground tracking-tight mb-2">Esta oferta ya no está disponible</h1>
            <p class="text-muted-foreground mb-8 leading-relaxed">El plazo de postulación venció o el empleador la desactivó.</p>
          </>
        ) : (
          <>
            <h1 class="text-2xl font-semibold text-foreground tracking-tight mb-2">Oferta no encontrada</h1>
            <p class="text-muted-foreground mb-8 leading-relaxed">El enlace puede estar desactualizado o la oferta fue eliminada.</p>
          </>
        )}
        <a href="/" class="btn-primary px-6 py-3">
          Ver otras ofertas
        </a>
      </div>
    </div>
  </Layout>
)}

{oferta && <Layout title={ofertaOgTitle} description={ofertaDescription} ogType="article" leaflet={true}>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <div class="page-hero">
    <div class="relative max-w-4xl mx-auto">
      <div class="flex items-center justify-between mb-6 gap-2 flex-wrap">
        <a href="/" class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground text-sm font-medium transition-colors duration-micro">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver a ofertas
        </a>
        <div class="flex items-center gap-2">
          <button
            id="btn-copiar-link"
            type="button"
            class="btn-ghost !text-sm !px-3 !py-1.5"
            title="Copiar link de la oferta"
            aria-label="Copiar link de la oferta"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span id="copy-link-txt">Copiar link</span>
          </button>
          <button
            id="btn-compartir"
            type="button"
            class="btn-ghost !text-sm !px-3 !py-1.5"
            title="Compartir oferta"
            aria-label="Compartir oferta"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            <span id="share-txt">Compartir</span>
          </button>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-input bg-muted border border-border flex items-center justify-center text-muted-foreground font-semibold text-sm shrink-0">
          {oferta.empresa.slice(0, 2).toUpperCase()}
        </div>
        <div>
          <h1 class="text-2xl sm:text-3xl font-semibold text-foreground leading-tight tracking-tight">{oferta.titulo}</h1>
          <p class="text-muted-foreground text-lg mt-1 font-medium">{oferta.empresa}</p>
          <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-sm text-muted-foreground">
            <span>{TIPOS[oferta.tipo_empleo] || oferta.tipo_empleo}</span>
            <span class="text-muted-foreground/35" aria-hidden="true">·</span>
            <span>{oferta.comuna}</span>
            {oferta.categoria && (
              <>
                <span class="text-muted-foreground/35" aria-hidden="true">·</span>
                <span>{oferta.categoria}</span>
              </>
            )}
          </p>
          <p class="text-xs text-muted-foreground mt-3">
            Publicada el {new Date(oferta.created_at).toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}
            &nbsp;·&nbsp; Vigente hasta {new Date(oferta.expira_en).toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
          <div class="mt-3 max-w-sm">
            <div class="flex items-center justify-between text-xs text-muted-foreground mb-1.5">
              <span>Publicada</span>
              <span class={diasRestantes <= 1 ? 'text-destructive font-medium' : diasRestantes <= 5 ? 'text-warning font-medium' : ''}>
                {urgenciaTexto}
              </span>
            </div>
            <div class="bg-muted rounded-full h-1 overflow-hidden">
              <div
                class={barraColor}
                style={barraWidth}
              ></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8 pb-24 md:pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Descripción -->
      <div class="card p-6">
        <h2 class="font-semibold text-foreground mb-4 flex items-baseline justify-between gap-2 tracking-tight">
          Descripción del cargo
          {readingTime > 0 && (
            <span class="text-xs text-muted-foreground font-normal tabular-nums">
              ~{readingTime} min
            </span>
          )}
        </h2>
        <div class="text-sm text-foreground/80 leading-relaxed whitespace-pre-line">
          {oferta.descripcion}
        </div>
      </div>

      <!-- Columna derecha: mapa + formulario -->
      <div class="space-y-6">
        <!-- Mini mapa -->
        {oferta.lat && oferta.lng && (
          <div class="card p-6">
            <h2 class="font-semibold text-foreground mb-3 tracking-tight">Ubicación</h2>
            <div id="mini-mapa" class="h-40 map-material"></div>
          </div>
        )}

        <!-- Formulario de postulación -->
        <div class="card p-6">
          <h2 class="font-semibold text-foreground mb-4 tracking-tight">Postular a esta oferta</h2>

          {exito ? (
            <div class="success-panel" role="status" aria-live="polite">
              <div class="w-12 h-12 bg-success/10 border border-success/25 rounded-input flex items-center justify-center mx-auto mb-4">
                <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class="text-foreground font-semibold text-lg tracking-tight">¡Postulación enviada!</p>
              <p class="text-sm text-muted-foreground mt-2 leading-relaxed max-w-xs mx-auto">
                Recibimos tu CV. El empleador verá un resumen y keywords extraídas automáticamente.
              </p>
              <div class="mt-4 flex flex-wrap justify-center gap-2 text-[11px] font-medium text-muted-foreground">
                <span class="inline-flex items-center gap-1 border border-border rounded-full px-2.5 py-1">Sin cuenta</span>
                <span class="inline-flex items-center gap-1 border border-border rounded-full px-2.5 py-1">CV privado 90 días</span>
              </div>
              <a href="/" class="btn-primary mt-6 !px-5">Ver más ofertas</a>
            </div>
          ) : (
            <form
              id="form-postulacion"
              action={`/api/postulaciones`}
              method="post"
              enctype="multipart/form-data"
              class="space-y-4"
            >
              <input type="hidden" name="oferta_id" value={oferta.id} />

              <div>
                <label for="postulacion-nombre" class="label-field">Nombre <span class="text-muted-foreground font-normal">(opcional)</span></label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none" aria-hidden="true">
                    <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                  </div>
                  <input
                    type="text"
                    id="postulacion-nombre"
                    name="nombre"
                    placeholder="Tu nombre"
                    autocomplete="name"
                    class="input-field-icon"
                  />
                </div>
              </div>

              <div>
                <label for="postulacion-email" class="label-field">Email <span class="text-muted-foreground font-normal">(opcional)</span></label>
                <div class="relative">
                  <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none" aria-hidden="true">
                    <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <input
                    type="email"
                    id="postulacion-email"
                    name="email"
                    placeholder="tu@email.com"
                    autocomplete="email"
                    class="input-field-icon"
                  />
                </div>
              </div>

              <div>
                <label for="cv-input" class="label-field">
                  CV <span class="text-destructive">*</span>
                  <span class="text-muted-foreground font-normal">&nbsp;PDF o Word, máx. 5MB</span>
                </label>
                <!-- Drop zone (touch-friendly en móvil) -->
                <div
                  id="cv-dropzone"
                  class="border border-dashed border-border rounded-card p-5 sm:p-4 min-h-[7.5rem] sm:min-h-0 hover:border-accent/40 active:border-accent/50 transition-colors cursor-pointer bg-muted/40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                  tabindex="0"
                  role="button"
                  aria-label="Subir CV PDF o Word, máximo 5MB"
                >
                  <input
                    type="file"
                    name="cv"
                    id="cv-input"
                    accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                    required
                    class="sr-only"
                  />
                  <div id="cv-placeholder" class="text-center py-3 sm:py-2">
                    <div class="w-12 h-12 sm:w-10 sm:h-10 mx-auto mb-2.5 rounded-input bg-muted border border-border flex items-center justify-center">
                      <svg class="w-6 h-6 sm:w-5 sm:h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                      </svg>
                    </div>
                    <p class="text-sm text-foreground/80 font-semibold">Toca o arrastra tu CV</p>
                    <p class="text-xs text-muted-foreground mt-1">PDF o Word · máx. 5 MB</p>
                  </div>
                  <div id="cv-preview" class="hidden flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-accent/10 text-accent flex items-center justify-center shrink-0">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                    <div class="min-w-0 flex-1">
                      <p id="cv-name" class="text-sm font-medium text-foreground truncate"></p>
                      <p id="cv-size" class="text-xs text-muted-foreground"></p>
                    </div>
                    <button type="button" id="cv-clear" class="text-xs text-muted-foreground hover:text-destructive font-medium shrink-0 px-2 py-1" aria-label="Quitar CV">
                      Quitar
                    </button>
                  </div>
                </div>
                <p class="text-[11px] text-muted-foreground mt-1.5">Máx. 3 postulaciones por hora · sin registro</p>
              </div>

              <div class="flex items-start gap-2.5">
                <input
                  type="checkbox"
                  id="privacidad"
                  name="privacidad"
                  required
                  class="mt-0.5 h-4 w-4 rounded border-border text-accent focus:ring-ring"
                />
                <label for="privacidad" class="text-xs text-muted-foreground leading-relaxed">
                  Acepto que mis datos y CV sean tratados para esta postulación y eliminados a los 90 días.
                </label>
              </div>

              <div id="error-msg" class="hidden alert-error" role="alert" aria-live="polite">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span></span>
              </div>

              <button
                type="submit"
                id="btn-postular"
                class="btn-primary w-full py-3.5 min-h-12 text-base sm:text-sm"
              >
                Enviar postulación
              </button>
            </form>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Sticky CTA móvil: se oculta cuando el form es visible -->
  {!exito && (
    <div
      id="sticky-cta"
      class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-background/95 backdrop-blur-md border-t border-border px-4 pt-3 translate-y-0 transition-transform duration-300 sticky-cta-safe"
    >
      <button
        type="button"
        id="sticky-btn"
        class="btn-primary w-full py-3.5 min-h-12 text-base"
        aria-label="Ir al formulario de postulación"
      >
        Postular a esta oferta
      </button>
    </div>
  )}
</Layout>}

<script define:vars={{ ofertaLat: oferta?.lat ?? null, ofertaLng: oferta?.lng ?? null, ofertaTitulo: oferta?.titulo ?? '', ofertaEmpresa: oferta?.empresa ?? '', MAP_TILE_DARK, MAP_TILE_LIGHT, BRAND_HEX }}>
  document.addEventListener('astro:page-load', () => {
    // Confetti si la postulación fue enviada con éxito
    if (window.location.search.includes('exito=1')) {
      (function launchConfetti() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const canvas = document.createElement('canvas');
        canvas.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:9999';
        document.body.appendChild(canvas);
        const ctx = canvas.getContext('2d');
        if (!ctx) { canvas.remove(); return; }
        canvas.width = innerWidth; canvas.height = innerHeight;
        const colors = ['#6aa8a2','#c8c4ba','#8a9aa8','#4d6b68'];
        const pieces = Array.from({length: 36}, () => ({
          x: Math.random() * canvas.width,
          y: -10 - Math.random() * 80,
          vx: (Math.random() - 0.5) * 6,
          vy: Math.random() * 3 + 1.5,
          color: colors[Math.floor(Math.random() * colors.length)],
          w: Math.random() * 10 + 5,
          h: Math.random() * 5 + 3,
          rot: Math.random() * Math.PI * 2,
          drot: (Math.random() - 0.5) * 0.15,
        }));
        let f = 0;
        const draw = () => {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          pieces.forEach(p => {
            p.x += p.vx; p.y += p.vy; p.vy += 0.07; p.rot += p.drot;
            ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot);
            ctx.fillStyle = p.color; ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
            ctx.restore();
          });
          if (++f < 200) requestAnimationFrame(draw); else canvas.remove();
        };
        requestAnimationFrame(draw);
      })();
    }

    // Sticky CTA móvil: scroll suave al form, se oculta cuando el form es visible
    const stickyCta = document.getElementById('sticky-cta');
    const stickyBtn = document.getElementById('sticky-btn');
    const formPostulacion = document.getElementById('form-postulacion');

    stickyBtn?.addEventListener('click', () => {
      formPostulacion?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    if (stickyCta && formPostulacion) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          stickyCta.style.transform = entry.isIntersecting ? 'translateY(100%)' : 'translateY(0)';
        },
        { threshold: 0.2 }
      );
      observer.observe(formPostulacion);
    }

    // Compartir / copiar link
    const btnCompartir = document.getElementById('btn-compartir');
    const shareTxt = document.getElementById('share-txt');
    const btnCopiarLink = document.getElementById('btn-copiar-link');
    const copyLinkTxt = document.getElementById('copy-link-txt');

    btnCopiarLink?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (copyLinkTxt) {
          copyLinkTxt.textContent = '¡Copiado!';
          setTimeout(() => { if (copyLinkTxt) copyLinkTxt.textContent = 'Copiar link'; }, 2000);
        }
      } catch {}
    });

    btnCompartir?.addEventListener('click', async () => {
      const url = window.location.href;
      try {
        if (navigator.share) {
          await navigator.share({ title: ofertaTitulo, text: `${ofertaTitulo} — ${ofertaEmpresa}`, url });
        } else {
          await navigator.clipboard.writeText(url);
          if (shareTxt) { shareTxt.textContent = '¡Copiado!'; setTimeout(() => { shareTxt.textContent = 'Compartir'; }, 2000); }
        }
      } catch {}
    });

    // Mini mapa (guard: no re-inicializar en navegación view-transitions)
    const miniMapaEl = document.getElementById('mini-mapa') as HTMLElement | null;
    if (miniMapaEl && ofertaLat && ofertaLng && !miniMapaEl.dataset.mapReady) {
      miniMapaEl.dataset.mapReady = '1';
      const miniMap = L.map('mini-mapa', { zoomControl: true, dragging: false }).setView([ofertaLat, ofertaLng], 14);
      const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      L.tileLayer(dark ? MAP_TILE_DARK : MAP_TILE_LIGHT, {
        attribution: '&copy; OSM &copy; CARTO',
        maxZoom: 18,
      }).addTo(miniMap);
      const pin = L.divIcon({
        html: '<div style="width:10px;height:10px;background:' + BRAND_HEX + ';border-radius:1px;border:1.5px solid oklch(0.93 0.01 95 / 0.9)"></div>',
        className: '',
        iconSize: [10, 10],
        iconAnchor: [5, 5],
      });
      L.marker([ofertaLat, ofertaLng], { icon: pin }).addTo(miniMap).bindPopup(ofertaTitulo);
    }

    // ── CV dropzone + validación cliente ──
    const MAX_CV = 5 * 1024 * 1024;
    const ALLOWED_EXT = ['.pdf', '.doc', '.docx'];
    const ALLOWED_MIME = [
      'application/pdf',
      'application/msword',
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
    ];

    const form = document.getElementById('form-postulacion') as HTMLFormElement | null;
    const btn = document.getElementById('btn-postular') as HTMLButtonElement | null;
    const errorMsg = document.getElementById('error-msg');
    const cvInput = document.getElementById('cv-input') as HTMLInputElement | null;
    const dropzone = document.getElementById('cv-dropzone');
    const cvPlaceholder = document.getElementById('cv-placeholder');
    const cvPreview = document.getElementById('cv-preview');
    const cvName = document.getElementById('cv-name');
    const cvSize = document.getElementById('cv-size');
    const cvClear = document.getElementById('cv-clear');

    function showError(msg: string) {
      const span = errorMsg?.querySelector('span');
      if (span) span.textContent = msg;
      if (errorMsg) errorMsg.classList.remove('hidden');
    }
    function hideError() {
      if (errorMsg) errorMsg.classList.add('hidden');
    }

    function validateCvFile(file: File): string | null {
      if (!file || file.size === 0) return 'Debes adjuntar tu CV.';
      if (file.size > MAX_CV) return 'El archivo supera los 5MB.';
      const name = file.name.toLowerCase();
      const okExt = ALLOWED_EXT.some((e) => name.endsWith(e));
      const okMime = !file.type || ALLOWED_MIME.includes(file.type) || file.type === 'application/octet-stream';
      if (!okExt && !okMime) return 'Solo se aceptan PDF o Word (.pdf, .docx, .doc).';
      if (!okExt) return 'La extensión del archivo debe ser .pdf, .docx o .doc.';
      return null;
    }

    function formatSize(bytes: number): string {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function setCvFile(file: File | null) {
      if (!cvInput) return;
      if (!file) {
        cvInput.value = '';
        cvPlaceholder?.classList.remove('hidden');
        cvPreview?.classList.add('hidden');
        dropzone?.classList.remove('border-accent/50', 'bg-accent/10');
        return;
      }
      const err = validateCvFile(file);
      if (err) {
        showError(err);
        setCvFile(null);
        return;
      }
      hideError();
      // Asignar al input via DataTransfer
      try {
        const dt = new DataTransfer();
        dt.items.add(file);
        cvInput.files = dt.files;
      } catch {
        /* algunos browsers antiguos no soportan DataTransfer; el input change maneja */
      }
      if (cvName) cvName.textContent = file.name;
      if (cvSize) cvSize.textContent = formatSize(file.size);
      cvPlaceholder?.classList.add('hidden');
      cvPreview?.classList.remove('hidden');
      dropzone?.classList.add('border-accent/50', 'bg-accent/10');
    }

    // Guard: avoid double-binding form/dropzone listeners on astro:page-load
    if (form?.dataset.bound === '1') return;
    if (form) form.dataset.bound = '1';

    dropzone?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#cv-clear')) return;
      cvInput?.click();
    });

    dropzone?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if ((e.target as HTMLElement).closest('#cv-clear')) return;
        cvInput?.click();
      }
    });

    cvInput?.addEventListener('change', () => {
      const f = cvInput.files?.[0] || null;
      if (f) setCvFile(f);
    });

    cvClear?.addEventListener('click', (e) => {
      e.stopPropagation();
      setCvFile(null);
    });

    ['dragenter', 'dragover'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('border-accent/50', 'bg-accent/10');
      });
    });
    ['dragleave', 'drop'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('border-accent/50', 'bg-accent/10');
      });
    });
    dropzone?.addEventListener('drop', (e) => {
      const de = e as DragEvent;
      const f = de.dataTransfer?.files?.[0];
      if (f) setCvFile(f);
    });

    const BTN_DEFAULT = 'Enviar postulación';
    const setBtnLoading = (label: string) => {
      if (!btn) return;
      btn.innerHTML = `<span class="spinner" aria-hidden="true"></span> ${label}`;
      btn.setAttribute('disabled', '');
      btn.setAttribute('aria-busy', 'true');
    };
    const resetBtn = () => {
      if (!btn) return;
      btn.textContent = BTN_DEFAULT;
      btn.removeAttribute('disabled');
      btn.removeAttribute('aria-busy');
    };

    // Formulario con feedback (parse es async en servidor → respuesta rápida)
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();

        const cv = cvInput?.files?.[0];
        const clientErr = validateCvFile(cv as File);
        if (clientErr) {
          showError(clientErr);
          return;
        }

        setBtnLoading('Subiendo CV…');

        try {
          const formData = new FormData(form);
          const res = await fetch('/api/postulaciones', { method: 'POST', body: formData });
          const data = await res.json();
          if (res.ok && data.ok) {
            if (btn) {
              btn.innerHTML = '<span class="spinner" aria-hidden="true"></span> ¡Listo!';
            }
            window.location.href = window.location.pathname + '?exito=1';
          } else {
            showError(data.error || 'No pudimos enviar tu postulación. Intenta de nuevo.');
            resetBtn();
          }
        } catch {
          showError('Sin conexión. Revisa tu internet e intenta otra vez.');
          resetBtn();
        }
      });
    }
  });
</script>
