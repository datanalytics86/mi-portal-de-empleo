---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Pagination from '../../components/ui/Pagination.astro';
import { TIPOS } from '../../lib/constants';
import {
  DASHBOARD_PAGE_SIZE,
  buildPageInfo,
  parsePage,
} from '../../lib/pagination';

const { client, empleador } = Astro.locals.session!;
const { searchParams, pathname } = Astro.url;
const page = parsePage(searchParams.get('page'));
const demoFilter = searchParams.get('demo'); // '1' | '0' | null

// Métricas globales (todas las ofertas del empleador, sin paginar)
let { data: allOfertas } = await client
  .from('ofertas')
  .select(`
    id, activa, expira_en, is_demo,
    postulaciones(count)
  `)
  .eq('empleador_id', empleador.id);
if (!allOfertas) {
  const retry = await client
    .from('ofertas')
    .select(`
      id, activa, expira_en,
      postulaciones(count)
    `)
    .eq('empleador_id', empleador.id);
  allOfertas = (retry.data ?? []).map((o) => ({ ...o, is_demo: false }));
}

const now = new Date();

const ofertasActivas = allOfertas?.filter(o => o.activa && new Date(o.expira_en) >= now).length ?? 0;
const ofertasExpiradas = allOfertas?.filter(o => !o.activa || new Date(o.expira_en) < now).length ?? 0;
const totalPostulaciones = allOfertas?.reduce((sum, o) => sum + ((o.postulaciones as { count: number }[])?.[0]?.count ?? 0), 0) ?? 0;
const totalOfertas = allOfertas?.length ?? 0;
const totalDemo = allOfertas?.filter((o) => o.is_demo).length ?? 0;
const filteredTotal =
  demoFilter === '1'
    ? totalDemo
    : demoFilter === '0'
      ? totalOfertas - totalDemo
      : totalOfertas;
const pageInfo = buildPageInfo(page, DASHBOARD_PAGE_SIZE, filteredTotal);

let dashQuery = client
  .from('ofertas')
  .select(`
    id, titulo, tipo_empleo, comuna, activa, expira_en, created_at, is_demo,
    postulaciones(count)
  `)
  .eq('empleador_id', empleador.id)
  .order('created_at', { ascending: false });
if (demoFilter === '1') dashQuery = dashQuery.eq('is_demo', true);
if (demoFilter === '0') dashQuery = dashQuery.eq('is_demo', false);
let { data: ofertas } = await dashQuery.range(pageInfo.from, pageInfo.to);
if (!ofertas) {
  let retryQuery = client
    .from('ofertas')
    .select(`
      id, titulo, tipo_empleo, comuna, activa, expira_en, created_at,
      postulaciones(count)
    `)
    .eq('empleador_id', empleador.id)
    .order('created_at', { ascending: false });
  const retry = await retryQuery.range(pageInfo.from, pageInfo.to);
  ofertas = (retry.data ?? []).map((o) => ({ ...o, is_demo: false }));
}

const ofertasDisplay = (ofertas ?? []).map((oferta) => {
  const expirada = new Date(oferta.expira_en) < now;
  const nPost = (oferta.postulaciones as { count: number }[])?.[0]?.count ?? 0;
  const estado = !oferta.activa ? 'Inactiva' : expirada ? 'Expirada' : 'Activa';
  const estadoColor = estado === 'Activa'
    ? 'text-success bg-success/10 border-success/25'
    : estado === 'Expirada'
    ? 'text-warning bg-warning/10 border-warning/25'
    : 'text-muted-foreground bg-muted border-border';
  const diasRestantes = Math.max(0, Math.ceil((new Date(oferta.expira_en).getTime() - now.getTime()) / (1000 * 60 * 60 * 24)));
  const totalDias = Math.max(1, Math.ceil((new Date(oferta.expira_en).getTime() - new Date(oferta.created_at).getTime()) / (1000 * 60 * 60 * 24)));
  const pctTranscurrido = Math.min(100, Math.round(((totalDias - diasRestantes) / totalDias) * 100));
  const barColor = diasRestantes <= 3 ? 'bg-destructive' : diasRestantes <= 7 ? 'bg-warning' : 'bg-accent';
  const barWidth = 'width: ' + pctTranscurrido + '%';
  const diasLabel = diasRestantes === 0
    ? 'Último día'
    : diasRestantes + ' día' + (diasRestantes !== 1 ? 's' : '') + ' restante' + (diasRestantes !== 1 ? 's' : '');
  const urgencia = !expirada && oferta.activa && diasRestantes <= 3;
  return { ...oferta, expirada, nPost, estado, estadoColor, diasRestantes, barColor, barWidth, diasLabel, urgencia };
});

const email = Astro.locals.session?.user?.email ?? '';
---

<Layout title="Panel de empleador">
  <div class="page-hero">
    <div class="relative max-w-5xl mx-auto">
      <div class="flex items-center justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-input bg-muted border border-border flex items-center justify-center text-muted-foreground font-semibold text-sm shrink-0">
            {empleador.empresa.slice(0, 2).toUpperCase()}
          </div>
          <div>
            <p class="text-muted-foreground text-[11px] font-medium tracking-[0.16em] uppercase">Panel empleador</p>
            <h1 class="text-2xl font-semibold text-foreground tracking-tight">{empleador.empresa}</h1>
            {email && <p class="text-muted-foreground text-xs mt-0.5">{email}</p>}
          </div>
        </div>
        <div class="flex gap-2">
          <a href="/empleador/oferta/nueva" class="btn-primary !py-2.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Nueva oferta
          </a>
          <form action="/api/auth/logout" method="post">
            <button type="submit" class="btn-secondary !py-2.5">
              Salir
            </button>
          </form>
        </div>
      </div>

      <dl class="grid grid-cols-3 gap-6 mt-8 max-w-lg">
        <div>
          <dt class="text-[10px] font-medium tracking-[0.16em] uppercase text-muted-foreground">Activas</dt>
          <dd id="metric-activas" data-target={ofertasActivas} class="mt-1 text-3xl font-semibold text-foreground tabular-nums">0</dd>
        </div>
        <div>
          <dt class="text-[10px] font-medium tracking-[0.16em] uppercase text-muted-foreground">Postulaciones</dt>
          <dd id="metric-postulaciones" data-target={totalPostulaciones} class="mt-1 text-3xl font-semibold text-foreground tabular-nums">0</dd>
        </div>
        <div>
          <dt class="text-[10px] font-medium tracking-[0.16em] uppercase text-muted-foreground">Expiradas</dt>
          <dd id="metric-expiradas" data-target={ofertasExpiradas} class="mt-1 text-3xl font-semibold text-muted-foreground tabular-nums">0</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 py-8">
    {ofertasDisplay.length === 0 ? (
      <EmptyState
        title="Sin ofertas todavía"
        description="Publica en un par de minutos. Los candidatos postulan solo con su CV."
        secondaryHref="/"
        secondaryLabel="Ver cómo se ven las ofertas →"
      >
        <a slot="actions" href="/empleador/oferta/nueva" class="btn-primary !px-6 !py-3">
          Publicar primera oferta
        </a>
      </EmptyState>
    ) : (
      <div>
        <div class="flex items-end justify-between gap-3 mb-5">
          <div>
            <h2 class="text-lg font-semibold text-foreground tracking-tight">Tus ofertas</h2>
            {totalDemo > 0 && (
              <p class="text-xs text-muted-foreground mt-2 flex flex-wrap gap-3">
                <a href="/empleador/dashboard" class:list={[!demoFilter && 'text-foreground font-medium']}>Todas</a>
                <a href="/empleador/dashboard?demo=0" class:list={[demoFilter === '0' && 'text-foreground font-medium']}>Reales</a>
                <a href="/empleador/dashboard?demo=1" class:list={[demoFilter === '1' && 'text-foreground font-medium']}>Demo</a>
              </p>
            )}
            <p class="text-sm text-muted-foreground mt-0.5">
              {totalOfertas} publicaci{totalOfertas === 1 ? 'ón' : 'ones'}
              {totalPostulaciones > 0 && (
                <span> · <span class="font-semibold text-accent">{totalPostulaciones}</span> CV{totalPostulaciones !== 1 ? 's' : ''} en total</span>
              )}
              {pageInfo.totalPages > 1 && (
                <span class="text-muted-foreground"> · pág. {pageInfo.page}/{pageInfo.totalPages}</span>
              )}
            </p>
          </div>
          <a
            href="/empleador/oferta/nueva"
            class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent transition-colors"
          >
            + Nueva
          </a>
        </div>

        <div class="space-y-3">
          {ofertasDisplay.map((oferta) => (
            <div class={`card p-4 sm:p-5 transition-all group ${oferta.urgencia ? 'border-warning/40' : ''}`}>
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="font-bold text-foreground group-hover:text-accent transition-colors tracking-tight text-base">
                      {oferta.titulo}
                    </h3>
                    <span class={`text-[11px] px-2.5 py-0.5 rounded-full font-semibold border ${oferta.estadoColor}`}>
                      {oferta.estado}
                    </span>
                    {oferta.is_demo && (
                      <span class="text-[11px] px-2 py-0.5 rounded-full font-medium border border-border text-muted-foreground">
                        Demo
                      </span>
                    )}
                    {oferta.urgencia && (
                      <span class="text-[11px] px-2 py-0.5 rounded-full font-medium bg-warning/10 text-warning border-warning/25 border">
                        Por vencer
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-muted-foreground mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                    <span class="inline-flex items-center gap-1 font-medium">
                      <svg class="w-3.5 h-3.5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      </svg>
                      {oferta.comuna}
                    </span>
                    <span class="text-muted-foreground/50">·</span>
                    <span>{TIPOS[oferta.tipo_empleo] || oferta.tipo_empleo}</span>
                    <span class="text-muted-foreground/50">·</span>
                    <span>Vence {new Date(oferta.expira_en).toLocaleDateString('es-CL')}</span>
                  </p>
                  {!oferta.expirada && oferta.activa && (
                    <div class="mt-3 max-w-xs">
                      <div class="bg-muted rounded-full h-1 overflow-hidden">
                        <div class={`h-full rounded-full transition-all ${oferta.barColor}`} style={oferta.barWidth}></div>
                      </div>
                      <p class="text-[11px] text-muted-foreground mt-1 font-medium">{oferta.diasLabel}</p>
                    </div>
                  )}
                </div>

                <div class="flex items-center gap-2 shrink-0 flex-wrap sm:flex-nowrap">
                  <div class={`text-center min-w-[3.25rem] px-3 py-2 rounded-xl border ${oferta.nPost > 0 ? 'bg-accent/10 border-accent/20' : 'bg-muted border-border'}`}>
                    <p class={`text-lg font-semibold leading-none tabular-nums ${oferta.nPost > 0 ? 'text-accent' : 'text-foreground/80'}`}>
                      {oferta.nPost}
                    </p>
                    <p class="text-[10px] text-muted-foreground mt-1 font-semibold uppercase tracking-wide">
                      {oferta.nPost === 1 ? 'CV' : 'CVs'}
                    </p>
                  </div>
                  <a
                    href={`/oferta/${oferta.id}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-icon"
                    aria-label="Ver oferta pública"
                    title="Ver oferta pública"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  <a
                    href={`/empleador/oferta/${oferta.id}/postulaciones`}
                    class="btn-primary"
                  >
                    Ver CVs
                  </a>
                  <form action="/api/ofertas/desactivar" method="post" class="inline">
                    <input type="hidden" name="id" value={oferta.id} />
                    <button
                      type="submit"
                      class="btn-secondary"
                      data-confirm="¿Desactivar esta oferta?"
                    >
                      {oferta.activa ? 'Desactivar' : 'Activar'}
                    </button>
                  </form>
                </div>
              </div>
            </div>
          ))}
        </div>
        <Pagination
          pageInfo={pageInfo}
          pathname={pathname}
          searchParams={searchParams}
          label="Paginación de ofertas del dashboard"
        />
      </div>
    )}
  </div>
</Layout>

<script>
  function animateCounter(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0', 10);
    if (target === 0) { el.textContent = '0'; return; }

    // Respect prefers-reduced-motion: set final number immediately
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = String(target);
      return;
    }

    const duration = 800;
    const start = performance.now();
    const step = (now: number) => {
      const elapsed = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - elapsed, 3);
      el.textContent = String(Math.round(eased * target));
      if (elapsed < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  document.addEventListener('astro:page-load', () => {
    ['metric-activas', 'metric-postulaciones', 'metric-expiradas'].forEach(id => {
      const el = document.getElementById(id);
      if (el) animateCounter(el);
    });

    // CSP strict: sin onclick inline — confirm vía data-confirm
    document.querySelectorAll<HTMLFormElement>('form[action="/api/ofertas/desactivar"]').forEach((form) => {
      if (form.dataset.confirmBound === '1') return;
      form.dataset.confirmBound = '1';
      form.addEventListener('submit', (e) => {
        const btn = form.querySelector<HTMLButtonElement>('[data-confirm]');
        const msg = btn?.dataset.confirm;
        if (msg && !window.confirm(msg)) {
          e.preventDefault();
        }
      });
    });
  });
</script>
