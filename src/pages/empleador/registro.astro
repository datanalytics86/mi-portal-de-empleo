---
import Layout from '../../layouts/Layout.astro';
import { getEmpleadorSession } from '../../lib/auth';

const session = await getEmpleadorSession(Astro.cookies);
if (session) return Astro.redirect('/empleador/dashboard');
---

<Layout title="Registro de empleador">
  <div class="relative min-h-[calc(100vh-140px)] flex items-center justify-center px-4 py-12">
    <div class="relative w-full max-w-md">
      <div class="mb-8 quiet-enter">
        <span class="brand-mark mb-5 block" aria-hidden="true"></span>
        <h1 class="text-2xl font-semibold text-foreground tracking-tight">Publica empleos gratis</h1>
        <p class="text-muted-foreground mt-1.5 text-sm">
          ¿Ya tienes cuenta?{' '}
          <a href="/empleador/login" class="text-accent hover:text-foreground font-medium">Inicia sesión</a>
        </p>
      </div>

      <div class="card p-8 quiet-enter" style="animation-delay:80ms">
        <form id="form-registro" class="space-y-5" novalidate>
          <div>
            <label for="reg-empresa" class="label-field">Nombre de la empresa</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none" aria-hidden="true">
                <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <input
                id="reg-empresa"
                type="text"
                name="empresa"
                required
                autocomplete="organization"
                placeholder="Empresa S.A."
                class="input-field-icon"
              />
            </div>
          </div>
          <div>
            <label for="reg-email" class="label-field">Email</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none" aria-hidden="true">
                <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <input
                id="reg-email"
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder="empresa@correo.cl"
                class="input-field-icon"
              />
            </div>
          </div>
          <div>
            <label for="reg-password" class="label-field">Contraseña</label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none" aria-hidden="true">
                <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <input
                id="reg-password"
                type="password"
                name="password"
                required
                minlength="8"
                autocomplete="new-password"
                placeholder="Mínimo 8 caracteres"
                class="input-field-icon pr-12"
              />
              <button
                type="button"
                id="toggle-password-reg"
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-muted-foreground hover:text-muted-foreground min-w-11 justify-center"
                aria-label="Mostrar contraseña"
                aria-controls="reg-password"
              >
                <svg id="eye-open-reg" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="eye-closed-reg" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
          </div>

          <div id="registro-error" class="hidden alert-error" hidden role="alert" aria-live="polite">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span></span>
          </div>
          <div id="registro-ok" class="hidden success-panel !p-4 text-left" role="status" aria-live="polite">
            <p class="text-sm font-semibold text-foreground">Cuenta lista</p>
            <p class="text-sm text-muted-foreground mt-0.5 leading-relaxed"><span id="registro-ok-txt"></span></p>
          </div>

          <button type="submit" id="btn-registro" class="btn-primary w-full py-3">
            <span id="btn-registro-txt">Crear cuenta gratis</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('form-registro') as HTMLFormElement | null;
    const btn = document.getElementById('btn-registro') as HTMLButtonElement | null;
    const btnTxt = document.getElementById('btn-registro-txt');
    const errEl = document.getElementById('registro-error') as HTMLDivElement | null;
    const okEl = document.getElementById('registro-ok') as HTMLDivElement | null;
    const pwd = document.getElementById('reg-password') as HTMLInputElement | null;
    const toggle = document.getElementById('toggle-password-reg');
    const eyeOpen = document.getElementById('eye-open-reg');
    const eyeClosed = document.getElementById('eye-closed-reg');

    toggle?.addEventListener('click', () => {
      if (!pwd) return;
      const show = pwd.type === 'password';
      pwd.type = show ? 'text' : 'password';
      eyeOpen?.classList.toggle('hidden', show);
      eyeClosed?.classList.toggle('hidden', !show);
      toggle.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!btn || !btnTxt || !errEl || !okEl) return;
      btnTxt.innerHTML = '<span class="spinner" aria-hidden="true"></span> Creando cuenta…';
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      errEl.classList.add('hidden');
      errEl.setAttribute('hidden', '');
      okEl.classList.add('hidden');

      try {
        const body = new FormData(form);
        const res = await fetch('/api/auth/registro', { method: 'POST', body });
        let data: { ok?: boolean; error?: string; requiresEmailConfirmation?: boolean } = {};
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
          try { data = await res.json(); } catch { data = {}; }
        }

        const okTxt = document.getElementById('registro-ok-txt');
        if (res.ok && data.ok) {
          if (data.requiresEmailConfirmation) {
            if (okTxt) okTxt.textContent = 'Revisa tu bandeja y confirma el email para poder iniciar sesión.';
            okEl.classList.remove('hidden');
            btnTxt.textContent = 'Cuenta creada';
          } else {
            if (okTxt) okTxt.textContent = '¡Listo! Te llevamos al panel de empleador…';
            okEl.classList.remove('hidden');
            setTimeout(() => { window.location.href = '/empleador/dashboard'; }, 1500);
          }
        } else {
          const span = errEl.querySelector('span');
          let msg = data.error || 'No pudimos crear la cuenta. Intenta de nuevo.';
          if (res.status === 429) {
            const retry = res.headers.get('Retry-After');
            msg = retry
              ? `Demasiados intentos. Espera ${retry}s e inténtalo de nuevo.`
              : 'Demasiados intentos de registro. Espera una hora e inténtalo de nuevo.';
          } else if (res.status === 403) {
            msg = 'Demasiados intentos';
          }
          if (span) span.textContent = msg;
          errEl.classList.remove('hidden');
          errEl.removeAttribute('hidden');
          btnTxt.textContent = 'Crear cuenta gratis';
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
        }
      } catch {
        const span = errEl.querySelector('span');
        if (span) span.textContent = 'Sin conexión. Revisa tu internet e intenta otra vez.';
        errEl.classList.remove('hidden');
        btnTxt.textContent = 'Crear cuenta gratis';
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
      }
    });
  });
</script>
