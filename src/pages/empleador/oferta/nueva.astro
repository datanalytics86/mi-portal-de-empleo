---
import Layout from '../../../layouts/Layout.astro';
import { COMUNAS_NOMBRES } from '../../../lib/comunas';
import { CATEGORIAS } from '../../../lib/constants';

// Fecha mínima (hoy) y máxima (6 meses) para expiración
const hoy = new Date().toISOString().split('T')[0];
const maxFecha = new Date();
maxFecha.setMonth(maxFecha.getMonth() + 6);
const maxFechaStr = maxFecha.toISOString().split('T')[0];

---

<Layout title="Nueva oferta">
  <div class="page-hero">
    <div class="relative max-w-2xl mx-auto">
      <a href="/empleador/dashboard" class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground text-sm font-medium transition-colors duration-micro mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Dashboard
      </a>
      <div>
        <h1 class="text-xl font-semibold text-foreground tracking-tight">Publicar nueva oferta</h1>
        <p class="text-muted-foreground text-sm mt-1">Usa una plantilla o escribe desde cero</p>
      </div>
    </div>
  </div>

  <div class="max-w-2xl mx-auto px-4 py-8">
    <div class="card p-6 sm:p-8">
      <form id="form-nueva" class="space-y-5">

        <!-- Título -->
        <div>
          <label for="titulo" class="label-field">
            Título del cargo <span class="text-destructive">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
              <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <input
              type="text"
              id="titulo"
              name="titulo"
              required
              maxlength="120"
              placeholder="Ej: Desarrollador Full Stack"
              class="input-field-icon"
            />
          </div>
        </div>

        <!-- Tipo + Categoría -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="tipo_empleo" class="label-field">
              Tipo de empleo <span class="text-destructive">*</span>
            </label>
            <select
              id="tipo_empleo"
              name="tipo_empleo"
              required
              class="input-field"
            >
              <option value="">Seleccionar...</option>
              <option value="full-time">Full-time</option>
              <option value="part-time">Part-time</option>
              <option value="freelance">Freelance</option>
              <option value="practica">Práctica</option>
            </select>
          </div>
          <div>
            <label for="categoria" class="label-field">
              Categoría <span class="text-destructive">*</span>
            </label>
            <select
              id="categoria"
              name="categoria"
              required
              class="input-field"
            >
              <option value="">Seleccionar...</option>
              {CATEGORIAS.map(cat => <option value={cat}>{cat}</option>)}
            </select>
          </div>
        </div>

        <!-- Comuna -->
        <div>
          <label for="comuna" class="label-field">
            Comuna <span class="text-destructive">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
              <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <select
              id="comuna"
              name="comuna"
              required
              class="input-field-icon appearance-none"
            >
              <option value="">Seleccionar comuna...</option>
              {COMUNAS_NOMBRES.map(c => <option value={c}>{c}</option>)}
            </select>
          </div>
        </div>

        <!-- Descripción -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="descripcion" class="block text-sm font-semibold text-foreground/80">
              Descripción del cargo <span class="text-destructive">*</span>
            </label>
            <span id="char-count" class="text-xs text-muted-foreground tabular-nums">0 / 2000</span>
          </div>
          <!-- Plantillas rápidas (rellenan descripción + categoría/tipo) -->
          <div class="flex flex-wrap gap-1.5 mb-2">
            <span class="text-xs text-muted-foreground flex items-center pr-1">Plantilla:</span>
            <button type="button" class="tpl-btn text-xs text-muted-foreground border border-border px-2.5 min-h-9 py-1.5 rounded-control hover:border-accent/40 hover:text-foreground transition-colors duration-micro font-medium" data-tpl="tech">
              Tecnología
            </button>
            <button type="button" class="tpl-btn text-xs text-muted-foreground border border-border px-2.5 min-h-9 py-1.5 rounded-control hover:border-accent/40 hover:text-foreground transition-colors duration-micro font-medium" data-tpl="ventas">
              Ventas
            </button>
            <button type="button" class="tpl-btn text-xs text-muted-foreground border border-border px-2.5 min-h-9 py-1.5 rounded-control hover:border-accent/40 hover:text-foreground transition-colors duration-micro font-medium" data-tpl="admin">
              Admin
            </button>
            <button type="button" class="tpl-btn text-xs text-muted-foreground border border-border px-2.5 min-h-9 py-1.5 rounded-control hover:border-accent/40 hover:text-foreground transition-colors duration-micro font-medium" data-tpl="practica">
              Práctica
            </button>
          </div>
          <textarea
            name="descripcion"
            id="descripcion"
            required
            maxlength="2000"
            rows="8"
            placeholder="Describe las responsabilidades, requisitos y condiciones del puesto..."
            class="input-field resize-y"
          ></textarea>
          <!-- Barra de progreso de caracteres -->
          <div class="mt-1.5 bg-muted rounded-full h-0.5 overflow-hidden">
            <div id="char-bar" class="h-full rounded-full bg-accent transition-all duration-150" style="width: 0%"></div>
          </div>
        </div>

        <!-- Fecha de cierre -->
        <div>
          <label for="expira_en" class="label-field">
            Fecha de cierre <span class="text-destructive">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
              <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <input
              type="date"
              id="expira_en"
              name="expira_en"
              required
              min={hoy}
              max={maxFechaStr}
              class="input-field-icon"
            />
          </div>
        </div>

        <!-- Error -->
        <div id="form-error" class="hidden alert-error" hidden role="alert" aria-live="polite">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="form-error-txt"></span>
        </div>

        <!-- Botones -->
        <div class="flex gap-3 pt-2">
          <button
            type="submit"
            id="btn-publicar"
            class="btn-primary flex-1 py-3"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            <span id="btn-txt">Publicar oferta</span>
          </button>
          <a
            href="/empleador/dashboard"
            class="btn-secondary"
          >
            Cancelar
          </a>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  type Plantilla = {
    titulo: string;
    categoria: string;
    tipo_empleo: string;
    descripcion: string;
  };

  const PLANTILLAS: Record<string, Plantilla> = {
    tech: {
      titulo: 'Desarrollador/a Full Stack',
      categoria: 'Tecnología',
      tipo_empleo: 'full-time',
      descripcion: `Buscamos un/a Desarrollador/a Full Stack para construir y mantener productos digitales de alto impacto.

Responsabilidades:
• Desarrollar y mantener aplicaciones web (frontend y/o backend)
• Participar en code reviews y buenas prácticas
• Colaborar con producto, diseño y otros equipos

Requisitos:
• Experiencia con JavaScript/TypeScript, React o similar
• Conocimiento de APIs REST y bases de datos (SQL)
• Trabajo en equipo y metodologías ágiles (Scrum/Kanban)

Ofrecemos:
• Modalidad híbrida o remota (según acuerdo)
• Sueldo competitivo según experiencia
• Stack moderno y aprendizaje continuo`,
    },
    ventas: {
      titulo: 'Ejecutivo/a de Ventas',
      categoria: 'Ventas',
      tipo_empleo: 'full-time',
      descripcion: `Buscamos un/a Ejecutivo/a de Ventas para expandir nuestra cartera de clientes en Chile.

Responsabilidades:
• Prospección y captación de nuevos clientes
• Cumplimiento de metas comerciales mensuales
• Seguimiento postventa y fidelización

Requisitos:
• Experiencia en ventas (mínimo 1 año)
• Alta orientación a resultados y metas
• Excelentes habilidades de comunicación y negociación

Ofrecemos:
• Sueldo base + comisiones
• Capacitación inicial y continua
• Incentivos por cumplimiento de metas`,
    },
    admin: {
      titulo: 'Asistente Administrativo/a',
      categoria: 'Administración',
      tipo_empleo: 'full-time',
      descripcion: `Buscamos un/a Asistente Administrativo/a para apoyar la operación diaria del equipo.

Responsabilidades:
• Gestión de documentos, agenda y correspondencia
• Apoyo en facturación, compras y control de gastos
• Atención a proveedores y coordinación interna

Requisitos:
• Manejo avanzado de Excel y herramientas Office
• Organización, proactividad y atención al detalle
• Experiencia previa en roles administrativos (deseable)

Ofrecemos:
• Buen ambiente laboral
• Horario full-time
• Sueldo a convenir según experiencia`,
    },
    practica: {
      titulo: 'Practicante',
      categoria: 'Otro',
      tipo_empleo: 'practica',
      descripcion: `Abrimos cupo de práctica profesional / laboral para estudiantes o egresados recientes.

Responsabilidades:
• Apoyar al equipo en tareas del día a día del área
• Participar en proyectos reales con supervisión
• Aprender herramientas y procesos de la industria

Requisitos:
• Estudiante de últimos años o egresado/a reciente
• Ganas de aprender, responsabilidad y proactividad
• Disponibilidad de [X] horas semanales

Ofrecemos:
• Tutoría y feedback continuo
• Experiencia real en el rubro
• Posibilidad de continuidad según desempeño
• (Indicar si es con o sin remuneración)`,
    },
  };

  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('form-nueva') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const textarea = document.getElementById('descripcion') as HTMLTextAreaElement | null;
    const charCount = document.getElementById('char-count');
    const charBar = document.getElementById('char-bar') as HTMLElement | null;

    function updateCharCount() {
      if (!textarea) return;
      const len = textarea.value.length;
      const max = 2000;
      if (charCount) charCount.textContent = `${len} / ${max}`;
      if (charBar) {
        const pct = Math.min(100, (len / max) * 100);
        charBar.style.width = pct + '%';
        charBar.className = 'h-full rounded-full transition-all duration-150 ' +
          (pct >= 90 ? 'bg-destructive' : pct >= 70 ? 'bg-warning' : 'bg-accent');
      }
    }

    textarea?.addEventListener('input', updateCharCount);

    document.querySelectorAll('.tpl-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLButtonElement;
        const key = el.dataset.tpl;
        const tpl = key ? PLANTILLAS[key] : undefined;
        if (!tpl || !textarea) return;
        if (textarea.value && !confirm('¿Reemplazar la descripción actual con la plantilla?')) return;

        textarea.value = tpl.descripcion;
        updateCharCount();

        const cat = form.querySelector('[name="categoria"]') as HTMLSelectElement | null;
        const tipo = form.querySelector('[name="tipo_empleo"]') as HTMLSelectElement | null;
        const titulo = form.querySelector('[name="titulo"]') as HTMLInputElement | null;
        if (cat) cat.value = tpl.categoria;
        if (tipo) tipo.value = tpl.tipo_empleo;
        if (titulo && !titulo.value.trim()) titulo.value = tpl.titulo;

        textarea.focus();
      });
    });

    const btn = document.getElementById('btn-publicar') as HTMLButtonElement | null;
    const btnTxt = document.getElementById('btn-txt');
    const errEl = document.getElementById('form-error') as HTMLDivElement | null;
    const errTxt = document.getElementById('form-error-txt');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!btn || !errEl) return;
      if (btnTxt) {
        btnTxt.innerHTML = '<span class="spinner" aria-hidden="true"></span> Publicando oferta…';
      }
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      errEl.classList.add('hidden');
      errEl.setAttribute('hidden', '');

      try {
        const body = new FormData(form);
        const res = await fetch('/api/ofertas/nueva', { method: 'POST', body });
        let data: { ok?: boolean; error?: string } = {};
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
          try { data = await res.json(); } catch { data = {}; }
        }

        if (res.ok && data.ok) {
          window.location.href = '/empleador/dashboard';
        } else {
          if (errTxt) errTxt.textContent = data.error || 'Error al publicar. Intenta de nuevo.';
          errEl.classList.remove('hidden');
          errEl.removeAttribute('hidden');
          if (btnTxt) btnTxt.textContent = 'Publicar oferta';
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
        }
      } catch {
        if (errTxt) errTxt.textContent = 'Error de conexión. Intenta de nuevo.';
        errEl.classList.remove('hidden');
        errEl.removeAttribute('hidden');
        if (btnTxt) btnTxt.textContent = 'Publicar oferta';
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
      }
    });
  });
</script>
