---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="max-w-lg mx-auto px-4 py-24">
    <p class="text-sm font-medium text-muted-foreground mb-3">404</p>
    <h1 class="text-2xl font-semibold tracking-tight text-foreground mb-2">Página no encontrada</h1>
    <p class="text-muted-foreground mb-8">
      La dirección no existe o fue eliminada.
    </p>
    <a href="/" class="btn-primary px-6 py-3">
      Ver ofertas
    </a>
  </div>
</Layout>
