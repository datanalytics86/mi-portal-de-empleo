---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="max-w-lg mx-auto px-4 py-24 text-center">
    <p class="font-display italic text-4xl text-muted-foreground/50 mb-4">404</p>
    <h1 class="text-2xl font-semibold tracking-tight text-foreground mb-2">Página no encontrada</h1>
    <p class="text-muted-foreground mb-8 leading-relaxed">
      La dirección que buscas no existe o fue eliminada.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="/" class="btn-primary px-6 py-3">
        Ver ofertas de empleo
      </a>
      <a href="/empleador/login" class="btn-secondary">
        Para empleadores
      </a>
    </div>
  </div>
</Layout>
