---
import { ViewTransitions } from 'astro:transitions';
import { getSessionFromCookies } from '../lib/auth';
import { resolvePublicOrigin } from '../lib/site-url';
import '../styles/frictionless-clarity.css';

interface Props {
  title: string;
  description?: string;
  leaflet?: boolean;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Portal de empleos en Chile. Postula con tu CV sin registro.',
  leaflet = false,
  ogImage,
  ogType = 'website',
} = Astro.props;
const fullTitle = title.includes('Portal de Empleos') ? title : `${title} | Portal de Empleos Chile`;
const publicOrigin = resolvePublicOrigin({ requestUrl: Astro.url, request: Astro.request });
const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, publicOrigin).href;
const defaultOgImage = new URL('/favicon.svg', publicOrigin).href;
const resolvedOgImage = ogImage || defaultOgImage;
const ogDescription = description.length > 200 ? description.slice(0, 197) + '…' : description;
const year = new Date().getFullYear();
const isEmpleador = !!getSessionFromCookies(Astro.cookies);
const isEmpleadorArea = Astro.url.pathname.startsWith('/empleador/');
/** Nonce CSP del middleware — scripts controlados (Leaflet). Ver security-headers.ts */
const cspNonce = Astro.locals.cspNonce ?? '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={ogDescription} />
    <meta name="theme-color" content="#f7f8fb" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Portal de Empleos Chile" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {leaflet && (
      <>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        {/* nonce: script controlado por nosotros; CSP también permite unpkg + unsafe-inline (Astro VT) */}
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" nonce={cspNonce || undefined}></script>
      </>
    )}
    <slot name="head" />
    <ViewTransitions />
  </head>
  <body class="min-h-dvh bg-background text-foreground font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2.5 focus:bg-card focus:text-foreground focus:rounded-control focus:font-semibold focus:text-sm"
    >
      Ir al contenido
    </a>

    <header class="site-header sticky top-0 z-40 border-b">
      <div class="max-w-measure mx-auto px-4 h-[var(--header-h)] flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="leading-none">
            <span class="block text-[0.95rem] font-semibold tracking-tight text-foreground">
              Empleos <span class="font-normal text-muted-foreground">Chile</span>
            </span>
            <span class="hidden sm:block mt-0.5 text-[11px] font-medium text-muted-foreground">
              Sin registro
            </span>
          </span>
        </a>
        <nav class="flex items-center gap-1 sm:gap-2 text-sm" aria-label="Principal">
          <a
            href="/"
            class="text-muted-foreground hover:text-foreground font-medium transition-colors duration-micro ease-quiet px-3 py-2 min-h-11 inline-flex items-center rounded-control"
          >
            Ofertas
          </a>
          {isEmpleador ? (
            <>
              <a href="/empleador/dashboard" class="btn-primary !py-2 !px-3.5">
                Mi panel
              </a>
              {isEmpleadorArea && (
                <form action="/api/auth/logout" method="post" class="inline">
                  <button type="submit" class="btn-ghost !py-2 !px-3">
                    Salir
                  </button>
                </form>
              )}
            </>
          ) : (
            <a
              href="/empleador/login"
              class="text-muted-foreground hover:text-foreground font-medium transition-colors duration-micro ease-quiet px-3 py-2 min-h-11 inline-flex items-center rounded-control"
            >
              Empleadores
            </a>
          )}
        </nav>
      </div>
    </header>

    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>

    <footer class="mt-24 border-t border-border">
      <div class="max-w-measure mx-auto px-4 py-12">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-10">
          <div class="max-w-sm">
            <div class="flex items-center gap-2 mb-3">
              <span class="brand-mark" aria-hidden="true"></span>
              <span class="text-sm font-semibold tracking-tight text-foreground">
                Empleos <span class="font-normal text-muted-foreground">Chile</span>
              </span>
            </div>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Postula con tu CV en segundos. Sin registro. Los datos se eliminan a los 90 días.
            </p>
          </div>
          <div class="flex flex-wrap gap-x-12 gap-y-6 text-sm">
            <div>
              <p class="text-[10px] font-medium text-muted-foreground uppercase tracking-[0.16em] mb-2.5">Candidatos</p>
              <a href="/" class="block text-foreground/80 hover:text-foreground transition-colors duration-micro mb-1.5">Ver ofertas</a>
              <p class="text-muted-foreground text-xs">PDF o Word · máx. 5 MB</p>
            </div>
            <div>
              <p class="text-[10px] font-medium text-muted-foreground uppercase tracking-[0.16em] mb-2.5">Empleadores</p>
              {isEmpleador ? (
                <a href="/empleador/dashboard" class="block text-foreground/80 hover:text-foreground transition-colors duration-micro mb-1.5">Mi panel</a>
              ) : (
                <>
                  <a href="/empleador/login" class="block text-foreground/80 hover:text-foreground transition-colors duration-micro mb-1.5">Ingresar</a>
                  <a href="/empleador/registro" class="block text-foreground/80 hover:text-foreground transition-colors duration-micro">Crear cuenta</a>
                </>
              )}
            </div>
          </div>
        </div>
        <div class="mt-10 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3">
          <p class="text-xs text-muted-foreground">
            &copy; {year} Portal de Empleos Chile
          </p>
          <a
            href={isEmpleador ? '/empleador/oferta/nueva' : '/empleador/login'}
            class="text-xs font-medium text-muted-foreground hover:text-accent transition-colors duration-micro"
          >
            Publicar empleo gratis
          </a>
        </div>
      </div>
    </footer>

    <button
      id="scroll-top"
      type="button"
      aria-label="Volver arriba"
      class="fixed bottom-20 md:bottom-6 right-5 z-40 w-10 h-10 min-h-11 min-w-11 bg-card text-muted-foreground border border-border rounded-control flex items-center justify-center opacity-0 pointer-events-none translate-y-1 transition-all duration-move ease-quiet hover:text-foreground hover:border-accent/40"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 15l7-7 7 7" />
      </svg>
    </button>
  </body>
</html>

<script>
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    const active = document.activeElement;
    if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT')) return;
    const searchInput = document.querySelector<HTMLInputElement>('input[name="q"]');
    if (!searchInput) return;
    e.preventDefault();
    searchInput.focus();
    searchInput.select();
  });

  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector<HTMLElement>('.site-header');
    const btn = document.getElementById('scroll-top');

    const onScroll = () => {
      const y = window.scrollY;
      header?.classList.toggle('is-scrolled', y > 8);
      if (!btn) return;
      const show = y > 400;
      btn.classList.toggle('opacity-0', !show);
      btn.classList.toggle('pointer-events-none', !show);
      btn.classList.toggle('translate-y-1', !show);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    btn?.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  });
</script>

<style is:global>
  :focus-visible {
    outline: 2px solid oklch(var(--ring));
    outline-offset: 2px;
  }

  .btn-primary {
    @apply inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground px-4 py-2.5 rounded-control text-sm font-semibold hover:opacity-90 disabled:opacity-60 disabled:pointer-events-none;
    transition: opacity var(--duration-micro) var(--ease-quiet), transform var(--duration-micro) var(--ease-quiet);
  }
  /* Alias legado — no usar en markup nuevo */
  .btn-gradient {
    @apply inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground px-4 py-2.5 rounded-control text-sm font-semibold hover:opacity-90 disabled:opacity-60 disabled:pointer-events-none;
    transition: opacity var(--duration-micro) var(--ease-quiet), transform var(--duration-micro) var(--ease-quiet);
  }
  .btn-secondary {
    @apply inline-flex items-center justify-center gap-2 border border-border text-foreground bg-card px-4 py-2.5 rounded-control text-sm font-medium hover:border-accent/40 disabled:opacity-60;
    transition: border-color var(--duration-micro) var(--ease-quiet), background-color var(--duration-micro) var(--ease-quiet);
  }
  .btn-ghost {
    @apply inline-flex items-center justify-center gap-2 text-muted-foreground px-3 py-2 rounded-control text-sm font-medium hover:text-foreground hover:bg-muted;
    transition: color var(--duration-micro) var(--ease-quiet), background-color var(--duration-micro) var(--ease-quiet);
  }
  .btn-icon {
    @apply inline-flex items-center justify-center min-h-11 min-w-11 p-2.5 rounded-control border border-border text-muted-foreground hover:text-foreground hover:border-accent/40;
    transition: color var(--duration-micro) var(--ease-quiet), border-color var(--duration-micro) var(--ease-quiet);
  }
  .input-field {
    @apply w-full border border-border rounded-input px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/70 bg-input/40;
  }
  .input-field-icon {
    @apply w-full border border-border rounded-input pl-10 pr-4 py-2.5 text-sm text-foreground placeholder:text-muted-foreground/70 bg-input/40;
  }
  .label-field {
    @apply block text-sm font-medium text-foreground/80 mb-1.5;
  }
  .card {
    @apply bg-card border border-border rounded-card;
    box-shadow: var(--shadow-quiet);
  }
  .alert-error {
    @apply text-sm text-destructive bg-destructive/10 border border-destructive/25 rounded-control p-3 flex items-center gap-2;
  }
  .alert-success {
    @apply text-sm text-success bg-success/10 border border-success/25 rounded-control p-3 flex items-center gap-2;
  }
  /* .alert-error usa display:flex; sin esto gana a Tailwind .hidden → franja rosa vacía */
  .alert-error.hidden,
  .alert-success.hidden {
    display: none !important;
  }
  [hidden] {
    display: none !important;
  }

  .spinner {
    @apply inline-block w-4 h-4 rounded-full border-2 border-primary-foreground/40 border-t-primary-foreground animate-spin shrink-0;
  }
  .spinner-dark {
    @apply inline-block w-4 h-4 rounded-full border-2 border-accent/25 border-t-accent animate-spin shrink-0;
  }

  .badge {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-medium border border-border bg-muted text-muted-foreground;
  }
  .badge-brand,
  .badge-muted {
    @apply badge;
  }
  .badge-success {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-medium border border-success/25 bg-success/10 text-success;
  }
  .badge-warning {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-medium border border-warning/25 bg-warning/10 text-warning;
  }
  .badge-danger {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-medium border border-destructive/25 bg-destructive/10 text-destructive;
  }
  .chip-skill {
    @apply text-xs bg-muted text-foreground/80 border border-border px-2.5 py-0.5 rounded-full font-medium;
  }
  .chip-soft {
    @apply text-xs bg-muted text-muted-foreground border border-border px-2.5 py-0.5 rounded-full;
  }

  .job-card {
    position: relative;
    display: flex;
    gap: 0.9rem;
    padding: 1rem 1.05rem;
    background: oklch(var(--card));
    border: 1px solid oklch(var(--border));
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-micro) var(--ease-quiet);
  }
  .job-card:hover {
    border-color: oklch(var(--accent) / 0.45);
  }
  .success-panel {
    @apply rounded-card border border-success/25 bg-success/5 p-6 text-center;
  }

  button:not(:disabled),
  [type='submit']:not(:disabled) {
    transition-property: transform, opacity, box-shadow, background-color, color, border-color;
    transition-duration: var(--duration-micro);
    transition-timing-function: var(--ease-quiet);
  }
  button:active:not(:disabled),
  [type='submit']:active:not(:disabled) {
    transform: scale(0.985);
  }

  input[type='text'],
  input[type='email'],
  input[type='password'],
  input[type='date'],
  input[type='search'],
  input[type='file'],
  select,
  textarea {
    transition: border-color var(--duration-micro) var(--ease-quiet), box-shadow var(--duration-micro) var(--ease-quiet);
  }

  .input-field:focus-visible,
  .input-field-icon:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid oklch(var(--ring));
    outline-offset: 1px;
  }

  .sticky-cta-safe {
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }

  .leaflet-popup-content-wrapper {
    border-radius: var(--radius-control) !important;
    background: oklch(var(--popover)) !important;
    color: oklch(var(--popover-foreground)) !important;
    box-shadow: var(--shadow-quiet) !important;
    border: 1px solid oklch(var(--border));
  }
  .leaflet-popup-tip {
    background: oklch(var(--popover)) !important;
    box-shadow: none !important;
  }
  .leaflet-container {
    background: oklch(var(--muted)) !important;
    font-family: var(--font-sans) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
