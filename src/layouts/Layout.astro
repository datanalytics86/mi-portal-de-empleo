---
import { ViewTransitions } from 'astro:transitions';
import { getSessionFromCookies } from '../lib/auth';

interface Props {
  title: string;
  description?: string;
  leaflet?: boolean;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Portal de empleos en Chile. Postula con tu CV sin registro.',
  leaflet = false,
  ogImage,
  ogType = 'website',
} = Astro.props;
const fullTitle = title.includes('Portal de Empleos') ? title : `${title} | Portal de Empleos Chile`;
const canonicalUrl = new URL(Astro.url.pathname + Astro.url.search, Astro.site || Astro.url.origin).href;
const defaultOgImage = new URL('/favicon.svg', Astro.site || Astro.url.origin).href;
const resolvedOgImage = ogImage || defaultOgImage;
const ogDescription = description.length > 200 ? description.slice(0, 197) + '…' : description;
const year = new Date().getFullYear();
const isEmpleador = !!getSessionFromCookies(Astro.cookies);
const isEmpleadorArea = Astro.url.pathname.startsWith('/empleador/');
/** Nonce CSP del middleware — scripts controlados (Leaflet). Ver security-headers.ts */
const cspNonce = Astro.locals.cspNonce ?? '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={ogDescription} />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Portal de Empleos Chile" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {leaflet && (
      <>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        {/* nonce: script controlado por nosotros; CSP también permite unpkg + unsafe-inline (Astro VT) */}
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" nonce={cspNonce || undefined}></script>
      </>
    )}
    <slot name="head" />
    <ViewTransitions />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2.5 focus:bg-white focus:text-brand-700 focus:rounded-xl focus:shadow-card focus:font-semibold focus:text-sm focus:ring-2 focus:ring-brand-500"
    >
      Ir al contenido
    </a>

    <!-- Header glass -->
    <header class="sticky top-0 z-40 border-b border-white/60 bg-white/80 backdrop-blur-xl shadow-soft">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 bg-gradient-to-br from-brand-500 to-brand-700 rounded-xl flex items-center justify-center shadow-glow group-hover:scale-105 transition-transform">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="leading-tight">
            <span class="block text-base font-bold text-slate-900 group-hover:text-brand-700 transition-colors tracking-tight">
              Empleos Chile
            </span>
            <span class="hidden sm:block text-[10px] font-medium text-slate-400 tracking-wide uppercase">
              Sin registro · Mapa · CV
            </span>
          </div>
        </a>
        <nav class="flex items-center gap-2 sm:gap-3 text-sm" aria-label="Principal">
          <a
            href="/"
            class="text-slate-500 hover:text-slate-900 font-medium transition-colors px-3 py-2 min-h-11 inline-flex items-center rounded-lg hover:bg-slate-100"
          >
            Ofertas
          </a>
          {isEmpleador ? (
            <>
              <a
                href="/empleador/dashboard"
                class="btn-primary !py-2 !px-4"
              >
                Mi panel
              </a>
              {isEmpleadorArea && (
                <form action="/api/auth/logout" method="post" class="inline">
                  <button type="submit" class="btn-secondary !py-2 !px-3.5">
                    Salir
                  </button>
                </form>
              )}
            </>
          ) : (
            <a
              href="/empleador/login"
              class="btn-gradient !py-2 !px-4"
            >
              Para empleadores
            </a>
          )}
        </nav>
      </div>
    </header>

    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-20 border-t border-slate-200/80 bg-white">
      <div class="max-w-6xl mx-auto px-4 py-10">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-8">
          <div class="max-w-sm">
            <div class="flex items-center gap-2 mb-3">
              <div class="w-7 h-7 bg-gradient-to-br from-brand-500 to-brand-700 rounded-lg flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <span class="text-sm font-bold text-slate-800">Empleos Chile</span>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed">
              Portal minimalista de empleos. Postula con tu CV en segundos, sin crear cuenta.
              Los datos se eliminan a los 90 días.
            </p>
          </div>
          <div class="flex flex-wrap gap-x-10 gap-y-4 text-sm">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Candidatos</p>
              <a href="/" class="block text-slate-600 hover:text-brand-700 transition-colors mb-1.5">Ver ofertas</a>
              <p class="text-slate-400 text-xs">PDF o Word · máx. 5 MB</p>
            </div>
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Empleadores</p>
              {isEmpleador ? (
                <a href="/empleador/dashboard" class="block text-slate-600 hover:text-brand-700 transition-colors mb-1.5">Mi panel</a>
              ) : (
                <>
                  <a href="/empleador/login" class="block text-slate-600 hover:text-brand-700 transition-colors mb-1.5">Ingresar</a>
                  <a href="/empleador/registro" class="block text-slate-600 hover:text-brand-700 transition-colors">Crear cuenta</a>
                </>
              )}
            </div>
          </div>
        </div>
        <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3">
          <p class="text-xs text-slate-400">
            &copy; {year} Portal de Empleos Chile
          </p>
          <a
            href={isEmpleador ? '/empleador/oferta/nueva' : '/empleador/login'}
            class="text-xs font-semibold text-brand-600 hover:text-brand-800 transition-colors"
          >
            Publicar empleo gratis →
          </a>
        </div>
      </div>
    </footer>

    <button
      id="scroll-top"
      type="button"
      aria-label="Volver arriba"
      class="fixed bottom-20 md:bottom-6 right-5 z-40 w-11 h-11 min-h-11 min-w-11 bg-white text-brand-700 border border-brand-100 rounded-full shadow-card flex items-center justify-center opacity-0 pointer-events-none translate-y-2 transition-all duration-300 hover:bg-brand-600 hover:text-white hover:border-brand-600 hover:scale-105"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
      </svg>
    </button>
  </body>
</html>

<script>
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    const active = document.activeElement;
    if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT')) return;
    const searchInput = document.querySelector<HTMLInputElement>('input[name="q"]');
    if (!searchInput) return;
    e.preventDefault();
    searchInput.focus();
    searchInput.select();
  });

  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('scroll-top');
    if (!btn) return;
    const toggle = () => {
      const show = window.scrollY > 400;
      btn.classList.toggle('opacity-0', !show);
      btn.classList.toggle('pointer-events-none', !show);
      btn.classList.toggle('translate-y-2', !show);
    };
    window.addEventListener('scroll', toggle, { passive: true });
    toggle();
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  });
</script>

<style is:global>
  ::selection {
    background: #c7d2fe;
    color: #1e1b4b;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Focus agradable y accesible */
  :focus-visible {
    outline: 2px solid #6366f1;
    outline-offset: 2px;
  }

  /* ── Design system utilities ── */
  .btn-primary {
    @apply inline-flex items-center justify-center gap-2 bg-brand-600 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-soft hover:bg-brand-700 disabled:opacity-60 disabled:pointer-events-none transition-colors;
  }
  .btn-gradient {
    @apply inline-flex items-center justify-center gap-2 bg-gradient-to-r from-brand-600 to-brand-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-soft hover:from-brand-700 hover:to-brand-800 hover:shadow-glow disabled:opacity-60 disabled:pointer-events-none transition-all;
  }
  .btn-secondary {
    @apply inline-flex items-center justify-center gap-2 border border-slate-200 text-slate-600 bg-white px-4 py-2.5 rounded-xl text-sm font-medium hover:bg-slate-50 hover:text-slate-800 disabled:opacity-60 transition-colors;
  }
  .btn-ghost {
    @apply inline-flex items-center justify-center gap-2 text-slate-500 px-3 py-2 rounded-xl text-sm font-medium hover:bg-slate-100 hover:text-slate-800 transition-colors;
  }
  .btn-icon {
    @apply inline-flex items-center justify-center min-h-11 min-w-11 p-2.5 rounded-xl border border-slate-200 text-slate-400 hover:bg-slate-50 hover:text-slate-600 transition-colors;
  }
  .input-field {
    @apply w-full border border-slate-300 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white;
  }
  .input-field-icon {
    @apply w-full border border-slate-300 rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent bg-white;
  }
  .label-field {
    @apply block text-sm font-semibold text-slate-700 mb-1.5;
  }
  .card {
    @apply bg-white border border-slate-200/90 rounded-2xl shadow-soft ring-1 ring-slate-900/5;
  }
  .alert-error {
    @apply text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl p-3 flex items-center gap-2;
  }
  .alert-success {
    @apply text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-xl p-3 flex items-center gap-2;
  }

  /* Spinner reutilizable (mismo look que Spinner.astro) */
  .spinner {
    @apply inline-block w-4 h-4 rounded-full border-2 border-white/40 border-t-white animate-spin shrink-0;
  }
  .spinner-dark {
    @apply inline-block w-4 h-4 rounded-full border-2 border-brand-200 border-t-brand-600 animate-spin shrink-0;
  }

  /* Badges / chips */
  .badge {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-semibold border;
  }
  .badge-brand {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-semibold border bg-brand-50 text-brand-700 border-brand-100;
  }
  .badge-success {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-semibold border bg-emerald-50 text-emerald-700 border-emerald-100;
  }
  .badge-warning {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-semibold border bg-amber-50 text-amber-800 border-amber-100;
  }
  .badge-danger {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-semibold border bg-red-50 text-red-700 border-red-100;
  }
  .badge-muted {
    @apply inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full font-semibold border bg-slate-50 text-slate-600 border-slate-100;
  }
  .chip-skill {
    @apply text-xs bg-indigo-50 text-indigo-800 border border-indigo-100 px-2.5 py-0.5 rounded-full font-medium;
  }
  .chip-soft {
    @apply text-xs bg-emerald-50 text-emerald-800 border border-emerald-100 px-2.5 py-0.5 rounded-full;
  }

  /* Card de oferta (listado público) — añade también class "group" en el markup */
  .job-card {
    @apply flex gap-3.5 bg-white border border-slate-200/90 rounded-2xl p-4 shadow-soft hover:border-brand-300 hover:shadow-card-hover hover:-translate-y-0.5 transition-all;
  }
  .job-card:focus-visible {
    outline: 2px solid #6366f1;
    outline-offset: 2px;
  }

  /* Success panel premium (postulación, registro) */
  .success-panel {
    @apply rounded-2xl border border-emerald-200 bg-gradient-to-b from-emerald-50 to-white p-6 text-center shadow-soft;
  }

  button:not(:disabled),
  [type='submit']:not(:disabled),
  a.btn-primary,
  a.btn-gradient {
    transition-property: transform, box-shadow, background-color, color, border-color, opacity;
    transition-duration: 160ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
  button:active:not(:disabled),
  [type='submit']:active:not(:disabled) {
    transform: scale(0.97);
  }

  input[type='text'],
  input[type='email'],
  input[type='password'],
  input[type='date'],
  input[type='search'],
  input[type='file'],
  select,
  textarea {
    transition: border-color 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
  }

  /* Contraste: placeholders y focus en inputs del design system */
  .input-field:focus-visible,
  .input-field-icon:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid #6366f1;
    outline-offset: 1px;
  }

  /* Safe area para sticky CTA iOS */
  .sticky-cta-safe {
    padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
  }

  .leaflet-popup-content-wrapper {
    border-radius: 12px !important;
    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.12) !important;
    border: 1px solid #e2e8f0;
  }
  .leaflet-popup-tip {
    box-shadow: none !important;
  }
</style>
