# Supabase
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Origen canónico (SEO + CSRF). En Vercel sin esto, url.origin es https://localhost.
PUBLIC_SITE_URL=https://mi-portal-de-empleo.vercel.app

# Neon (listado público + postulaciones). En Vercel: DATABASE_URL o POSTGRES_URL
# DATABASE_URL=postgresql://...

# xAI (SpaceXAI / Grok) — opcional pero recomendado para parsing de alta calidad
# https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Edge Function parse-cv (opcional) — reintentos async si el parse falla en Vercel
# SUPABASE_EDGE_PARSE_CV_URL=https://xxxxxxxxxxxx.supabase.co/functions/v1/parse-cv

# OCR para PDFs escaneados (sin capa de texto)
CV_OCR_ENABLED=true
CV_OCR_MAX_PAGES=3
CV_OCR_TIMEOUT_MS=50000
# Recomendado en Vercel: OCR.space (acepta PDF multipágina, sin binarios)
# Free key: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=

# Upstash Redis — rate limiting distribuido (opcional, recomendado en Vercel multi-instancia)
# Sin estas vars: fallback in-memory por proceso (funcional en local / single instance)
# 1. Crear DB en https://console.upstash.com → Redis
# 2. Copiar REST URL y REST TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry — observabilidad de errores (opcional)
# Sin DSN: logs estructurados en consola; la app funciona igual
# https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
